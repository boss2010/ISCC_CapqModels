@model List<ViewModels.ExportImportActivity_API.Ex_Im_CheckRequest_GetAllByUser_DateVM>
@{
    bool isCommitteePage = ViewBag.CheckRequestId != null;
    ViewData["Title"] = isCommitteePage ? "لجان الطلب" : "طلبات الوارد";
    int total = Model.Select(x => x.checkRequest_Id).Distinct().Count();
    int newCount = Model.Count(x => x.WorkStatusKey == "new");
    int workingCount = Model.Count(x => x.WorkStatusKey == "working");
    int completedCount = Model.Count(x => x.WorkStatusKey == "completed");
    int canceledCount = Model.Count(x => x.WorkStatusKey == "canceled");
    var requestGroups = Model.GroupBy(x => new { x.checkRequest_Id, x.CheckRequest_Number, x.CompanyName }).ToList();
    string RequestCategory(IEnumerable<ViewModels.ExportImportActivity_API.Ex_Im_CheckRequest_GetAllByUser_DateVM> group) =>
        group.Any(x => x.RequestQuarantineComplete) ? "completed" :
        group.Any(x => x.Committee_Type_Id == 13 && x.HasPendingLabResult) ? "pending-lab" :
        group.All(x => x.WorkStatusKey is "completed" or "canceled") ? "completed" : "today";
    var todayRequestGroups = requestGroups.Where(g => RequestCategory(g) == "today").ToList();
    var completedRequestGroups = requestGroups.Where(g => RequestCategory(g) == "completed").ToList();
    var pendingLabRequestGroups = requestGroups.Where(g => RequestCategory(g) == "pending-lab").ToList();
}

<style>
    .request-choice[hidden] { display:none !important; }
    .status-cards { display:grid; gap:14px; grid-template-columns:repeat(5,minmax(0,1fr)); }
    .status-card { background:#fff; border:1px solid #dbe8e8; border-radius:12px; color:#405658; cursor:pointer; padding:15px; text-align:right; transition:.2s; }
    .status-card:hover,.status-card.active { border-color:#178b91; box-shadow:0 5px 16px rgba(23,139,145,.15); transform:translateY(-2px); }
    .status-card.active { background:#eaf9f7; }
    .status-card span { display:block; font-size:.9rem; }
    .status-card strong { color:#147d83; display:block; font-size:1.65rem; margin-top:4px; }
    .status-badge { border-radius:20px; display:inline-block; font-weight:700; padding:5px 12px; }
    .status-new { background:#eef2f4; color:#52636a; }
    .status-working { background:#fff4d8; color:#936b00; }
    .status-completed { background:#dcf5e7; color:#187446; }
    .status-canceled { background:#fde4e4; color:#a43131; }
    .member-list { display:flex; flex-direction:column; gap:6px; text-align:right; }
    .member-row { align-items:center; display:flex; gap:7px; white-space:nowrap; }
    .member-role { border-radius:12px; font-size:.75rem; font-weight:700; padding:3px 8px; }
    .role-admin { background:#dff3f1; color:#147d83; }
    .role-assistant { background:#edf0f3; color:#56656a; }
    .attachment-uploaded { background:#dcf5e7; color:#187446; }
    .attachment-missing { background:#fde4e4; color:#a43131; }
    .work-master-detail { display:grid; gap:18px; grid-template-columns:minmax(0,1fr); }
    .work-panel { background:#fff; border:1px solid #dbe8e8; border-radius:16px; box-shadow:0 6px 20px rgba(31,78,82,.07); overflow:hidden; }
    .work-panel-header { background:#f2fbfa; border-bottom:1px solid #dbe8e8; padding:16px 18px; }
    .request-list { display:flex; flex-direction:column; gap:9px; padding:12px; }
    .request-choice { background:#fff; border:1px solid #dce8e8; border-radius:12px; color:#30484a; padding:14px; text-align:right; transition:.2s; width:100%; }
    .request-choice:hover,.request-choice.active { background:#eaf9f7; border-color:#178b91; box-shadow:0 4px 12px rgba(23,139,145,.12); }
    .request-choice strong,.request-choice span { display:block; }
    .request-choice small { color:#6c7e80; }
    .request-tabs { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:12px; }
    .request-tab { background:#f4faf9; border:1px solid #cfe6e3; border-radius:9px; color:#176f75; cursor:pointer; font-weight:700; padding:10px 14px; }
    .request-tab.active { background:#178b91; color:#fff; }
    .committee-list { display:grid; gap:12px; padding:16px; }
    .committee-card { align-items:center; border:1px solid #dce8e8; border-radius:13px; display:grid; gap:14px; grid-template-columns:minmax(180px,1fr) minmax(180px,1fr) auto; padding:15px; }
    .committee-card[hidden] { display:none; }
    .committee-title { color:#147d83; font-size:1.05rem; font-weight:800; }
    .committee-stage { color:#6a7a7c; font-size:.85rem; margin-top:5px; }
    .sample-barcodes { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
    .sample-barcode-entry { display:flex; flex-wrap:wrap; align-items:center; gap:8px; width:100%; }
    .sample-barcodes-label { flex-basis:100%; font-size:.85rem; color:#52636a; }
    .sample-barcode { background:#f2fbfa; border:1px solid #dbe8e8; border-radius:6px; padding:4px 8px; font-family:monospace; font-size:1rem; user-select:all; overflow-wrap:anywhere; max-width:100%; }
    .committee-empty { padding:50px 20px; text-align:center; }
    .import-requests { overflow-wrap:anywhere; }
    .import-requests .gap-2 { gap:8px; }
    .import-requests .gap-3 { gap:16px; }
    .import-requests .work-panel,.import-requests .committee-card > * { min-width:0; }
    .import-requests .member-row { flex-wrap:wrap; white-space:normal; }
    .import-requests .member-role { flex-shrink:0; }
    .import-requests .status-badge { margin-bottom:4px; white-space:normal; }
    .import-requests .request-date-filter { padding:0; background:transparent; }
    .request-date-filter > div { min-width:0; }
    .request-date-filter .form-label { display:block; margin-bottom:6px; }
    .request-date-filter .btn { min-height:44px; }
    .request-user-info { display:flex; flex-wrap:wrap; gap:4px 16px; }
    @@media(max-width:1199.98px){.committee-card{grid-template-columns:minmax(0,1fr)}.committee-card .btn{width:100%}}
    @@media(max-width:900px){
        .work-master-detail{grid-template-columns:minmax(0,1fr)}
        .request-list{max-height:none}
        .status-cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
        .status-card:first-child{grid-column:1 / -1;display:flex;align-items:center;justify-content:space-between}
        .status-card:first-child strong{margin-top:0}
    }
    @@media(max-width:575.98px){
        .import-requests{padding:16px 12px !important}
        .import-requests h2{font-size:1.5rem}
        .import-requests h4{font-size:1.15rem}
        .request-page-header > div,.import-requests .request-date-filter{width:100%}
        .request-user-info{font-size:.85rem}
        .request-user-info > span:first-child{flex-basis:100%}
        .request-date-filter > div{flex:1}
        .request-date-filter .form-control{width:100%;min-width:0;min-height:44px;font-size:16px}
        .status-card{padding:10px 12px}
        .status-card span{font-size:.85rem}
        .status-card strong{font-size:1.35rem}
        .work-master-detail{gap:14px}
        .work-panel-header{padding:12px}
        .request-list,.committee-list{padding:10px}
        .request-choice,.committee-card{padding:12px}
        .committee-card{gap:10px}
        .import-requests .btn{min-height:44px;white-space:normal}
        #openQuarantine{width:100%}
        #quarantineModal .modal-dialog,#laboratoryResultModal .modal-dialog{margin:8px}
        #quarantineModal .modal-body,#laboratoryResultModal .modal-body{padding:10px;overflow-wrap:anywhere}
        #quarantineModal form,#laboratoryResultModal form{padding:0}
        #quarantineModal .badge{white-space:normal}
        #quarantineModal select{display:block;width:100%;min-width:0;min-height:44px;font-size:16px}
        #quarantineModal button[type="submit"]{width:100%;min-height:44px;padding-inline:12px !important}
    }
</style>

<div class="container py-4 import-requests" dir="rtl">
    @if (TempData["SaveSuccess"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    <div class="request-page-header d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="text-primary mb-2">@ViewData["Title"]</h2>
            <div class="text-muted request-user-info"><span>اسم المستخدم: <strong>@ViewBag.UserName</strong></span><span>رقم المستخدم: <strong>@ViewBag.UserId</strong></span><span>رقم الموظف: <strong>@ViewBag.EmployeeId</strong></span></div>
        </div>
@if (isCommitteePage) { <a asp-action="Index" asp-route-date="@ViewBag.SelectedDate" class="btn btn-outline-secondary">العودة للطلبات</a> } else {
        <form method="get" asp-controller="ImportRequests" asp-action="Index" class="request-date-filter d-flex align-items-end gap-2">
            <div><label for="date" class="form-label">تاريخ اللجنة</label><input id="date" name="date" type="date" value="@ViewBag.SelectedDate" class="form-control" /></div>
            <button type="submit" class="btn btn-primary">عرض</button>
        </form>
        }
    </div>

    @if (ViewBag.PageError != null)
    {
        <div class="alert alert-danger text-center">@ViewBag.PageError</div>
    }
    else
    {
        @if (isCommitteePage) {
        <div class="status-cards mb-4" id="statusCards">
            <button type="button" class="status-card active" data-filter="all"><span>إجمالي اللجان</span><strong>@Model.Count</strong></button>
            <button type="button" class="status-card" data-filter="new"><span>لجان جديدة</span><strong>@newCount</strong></button>
            <button type="button" class="status-card" data-filter="working"><span>لجان جاري العمل</span><strong>@workingCount</strong></button>
            <button type="button" class="status-card" data-filter="completed"><span>لجان منتهية</span><strong>@completedCount</strong></button>
            <button type="button" class="status-card" data-filter="canceled"><span>لجان ملغاة</span><strong>@canceledCount</strong></button>
        </div>

        }
        @if (Model.Count == 0)
        {
            <div class="alert alert-info text-center">لا توجد طلبات وارد مسندة للمستخدم في التاريخ المحدد.</div>
        }
        else
        {
            <div class="work-master-detail">
                @if (!isCommitteePage) {
                <section class="work-panel">
                    <div class="work-panel-header"><h4 class="mb-1 text-primary">الطلبات (@total)</h4><div class="text-muted">اضغط على الطلب لعرض اللجان التابعة له</div></div>
                    <div class="request-tabs" id="requestTabs">
                        <button type="button" class="request-tab active" data-request-filter="today">طلبات اليوم <span>@todayRequestGroups.Count</span></button>
                        <button type="button" class="request-tab" data-request-filter="completed">تم الانتهاء <span>@completedRequestGroups.Count</span></button>
                        <button type="button" class="request-tab" data-request-filter="pending-lab">تنتظر نتيجة المعمل <span>@pendingLabRequestGroups.Count</span></button>
                    </div>
                    <div class="request-list" id="requestList">
                    @foreach (var request in requestGroups)
                    {
                        var category = RequestCategory(request);
                        <a asp-action="Committees" asp-route-checkRequestId="@request.Key.checkRequest_Id" asp-route-date="@ViewBag.SelectedDate" class="request-choice" hidden="@(category != "today")" data-request="@request.Key.checkRequest_Id" data-category="@category" data-statuses="@string.Join(',', request.Select(x => x.WorkStatusKey).Distinct())">
                            <strong>طلب رقم @request.Key.CheckRequest_Number</strong>
                            <span>@request.Key.CompanyName</span>
                            <small>عدد اللجان: @request.Count()</small>
                            @foreach (var committeeType in request.GroupBy(x => x.Committee_Type_Name))
                            {
                                <span class="text-muted">@committeeType.Key: @committeeType.Count()</span>
                            }
                        </a>
                    }
                    </div>
                </section>
                } else {
                <section class="work-panel">
                    <div class="work-panel-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div><h4 class="mb-1 text-primary">اختر اللجنة</h4><div class="text-muted" id="selectedRequestText">طلب رقم @Model.First().CheckRequest_Number — @Model.First().CompanyName</div></div>
                        <button type="button" class="btn btn-warning fw-bold" id="openQuarantine">موقف الحجر للطلب</button>
                    </div>
                    <div class="committee-empty d-none" id="committeeEmpty"><div class="fs-1 mb-2">☝️</div><strong>اختر طلبًا من القائمة أولًا</strong></div>
                    <div class="committee-list" id="committeeList">
                    @foreach (var item in Model)
                    {
                        string stage = item.Committee_Type_Id == 11 ? "الفحص ← السحب إن وجد ← موقف الحجر" : item.Committee_Type_Id == 13 ? "سحب العينات ← النتيجة" : "تنفيذ المعالجة";
                        <article class="committee-card" data-request="@item.checkRequest_Id" data-status="@item.WorkStatusKey">
                            <div>
                                <div class="committee-title">@item.Committee_Type_Name</div><div class="committee-stage">@stage</div>
                                @if (!string.IsNullOrWhiteSpace(item.SampleBarcodes))
                                {
                                    <div class="sample-barcodes">
                                        <span class="sample-barcodes-label">باركود عينات السحب</span>
                                        @foreach (var barcode in item.SampleBarcodes.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.Ordinal))
                                        {
                                            <div class="sample-barcode-entry"><bdi class="sample-barcode" dir="ltr">@barcode</bdi>
                                            @if (item.IsAdmin && item.CanShowLaboratoryResult) { <button type="button" class="btn btn-warning laboratory-result-button" data-committee="@item.Committee_ID" data-barcode="@barcode">@(item.PendingLabBarcodes.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Contains(barcode, StringComparer.Ordinal) ? "نتيجة المعمل" : "عرض نتيجة المعمل")</button> }</div>
                                        }
                                    </div>
                                }
                            </div>
                            <div>
                                <span class="status-badge status-@item.WorkStatusKey">@item.WorkStatusName</span>
                                @if (item.Committee_Type_Id == 13) { <span class="status-badge ms-1 @(item.SampleAttachmentUploaded ? "attachment-uploaded" : "attachment-missing")">@(item.SampleAttachmentUploaded ? "المرفق موجود" : "بدون مرفق")</span> }
                                <div class="member-list mt-2">
                                @foreach (var member in item.CommitteeMembers.Split('|', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    bool adminMember = member.EndsWith("(أدمن)");
                                    string memberName = member.Replace(" (أدمن)", "").Replace(" (مساعد)", "");
                                    <div class="member-row"><span>@memberName</span><span class="member-role @(adminMember ? "role-admin" : "role-assistant")">@(adminMember ? "أدمن" : "مساعد")</span></div>
                                }
                                </div>
                            </div>
                                <a asp-controller="ImportRequestDetails" asp-action="Index" asp-route-checkRequestId="@item.checkRequest_Id" asp-route-committeeId="@item.Committee_ID" asp-route-committeeTypeId="@item.Committee_Type_Id" class="btn @(item.IsReadOnly || (item.Committee_Type_Id == 11 && item.InspectionComplete && item.IsAdmin) || (item.Committee_Type_Id == 13 && item.IsAdmin) ? "btn-outline-secondary" : "btn-primary")">@item.ActionText</a>
                        </article>
                    }
                    </div>
                </section>
                }
            </div>
        }
    }
</div>

<div class="modal fade" id="laboratoryResultModal" tabindex="-1" aria-hidden="true" dir="rtl"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 class="modal-title text-primary">نتيجة المعمل</h5><button type="button" class="close ml-0" data-dismiss="modal"><span>&times;</span></button></div><div class="modal-body" id="laboratoryResultBody"></div></div></div></div>

<div class="modal fade" id="quarantineModal" tabindex="-1" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-primary">تحديد موقف الحجر</h5>
                <button type="button" class="close ml-0" data-dismiss="modal" aria-label="إغلاق">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="quarantineModalBody"><div class="text-center py-5">جارٍ التحميل...</div></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (() => {
        const cards = [...document.querySelectorAll('.status-card')];

        const committees = [...document.querySelectorAll('.committee-card')];
        const committeeList = document.getElementById('committeeList');
        const committeeEmpty = document.getElementById('committeeEmpty');

        const quarantineButton = document.getElementById('openQuarantine');
        const quarantineBody = document.getElementById('quarantineModalBody');
        const quarantineElement = document.getElementById('quarantineModal');
        let statusFilter = 'all';
        const selectedRequest = '@ViewBag.CheckRequestId';
        const renderCommittees = () => {
            let visible = 0;
            committees.forEach(card => {
                const show = card.dataset.request === selectedRequest && (statusFilter === 'all' || card.dataset.status === statusFilter);
                card.hidden = !show;
                if (show) visible++;
            });
            committeeList?.classList.toggle('d-none', !selectedRequest || visible === 0);
            committeeEmpty?.classList.toggle('d-none', !!selectedRequest && visible > 0);
            if (selectedRequest && visible === 0 && committeeEmpty) committeeEmpty.innerHTML = '<strong>لا توجد لجان لهذا الطلب في الحالة المختارة.</strong>';
        };
        cards.forEach(card => card.addEventListener('click', () => {
            cards.forEach(x => x.classList.remove('active'));
            card.classList.add('active');
            statusFilter = card.dataset.filter;
            renderCommittees();
        }));
        document.querySelectorAll('.request-tab').forEach(tab => tab.addEventListener('click', () => {
            document.querySelectorAll('.request-tab').forEach(x => x.classList.remove('active'));
            tab.classList.add('active');
            const filter = tab.dataset.requestFilter;
            document.querySelectorAll('.request-choice').forEach(request => {
                const category = request.dataset.category;
                request.hidden = category !== filter;
            });
        }));
        document.querySelector('.request-tab[data-request-filter="today"]')?.click();
        quarantineButton?.addEventListener('click', async () => {
            if (!selectedRequest || !quarantineBody || !quarantineElement) return;
            quarantineBody.innerHTML = '<div class="text-center py-5">جارٍ تحميل النباتات واللوطات...</div>';
            $(quarantineElement).modal('show');
            try {
                const response = await fetch(`@Url.Action("QuarantineLots", "ImportRequests")?checkRequestId=${encodeURIComponent(selectedRequest)}`);
                if (!response.ok) throw new Error(await response.text());
                quarantineBody.innerHTML = await response.text();
            } catch (error) {
                quarantineBody.innerHTML = `<div class="alert alert-danger">${error.message || 'تعذر تحميل موقف الحجر.'}</div>`;
            }
        });
        quarantineBody?.addEventListener('submit', async event => {
            const form = event.target.closest('#requestQuarantineForm');
            if (!form) return;
            event.preventDefault();
            if (!form.checkValidity()) { form.reportValidity(); return; }
            const button = form.querySelector('button[type="submit"]');
            if (button) { button.disabled = true; button.textContent = 'جارٍ الحفظ...'; }
            try {
                const response = await fetch(form.action, { method:'POST', body:new FormData(form) });
                const text = await response.text();
                if (!response.ok) throw new Error(text);
                quarantineBody.innerHTML = '<div class="alert alert-success">تم حفظ موقف الحجر بنجاح.</div>';
            } catch (error) {
                if (button) { button.disabled = false; button.textContent = 'حفظ موقف الحجر'; }
                alert(error.message || 'تعذر حفظ موقف الحجر.');
            }
        });
    })();
</script>
<script src="~/js/laboratory-result.js" asp-append-version="true"></script>
<script>
 document.addEventListener('lab-result-saved', event => {
    const body = event.target.closest('#laboratoryResultBody');
    if (!body) return;
    window.location.reload();
 });
 document.querySelectorAll('.laboratory-result-button').forEach(button=>button.addEventListener('click',async()=>{const body=document.getElementById('laboratoryResultBody');body.dataset.committee=button.dataset.committee;body.dataset.barcode=button.dataset.barcode;body.innerHTML='<div class="text-center py-5">جارٍ تحميل بيانات العينة...</div>';$('#laboratoryResultModal').modal('show');try{const response=await fetch(`/LaboratoryResult/Find?committeeId=${encodeURIComponent(button.dataset.committee)}&code=${encodeURIComponent(button.dataset.barcode)}`);if(!response.ok)throw new Error(await response.text());body.innerHTML=await response.text();window.dispatchEvent(new CustomEvent('lab-form-loaded',{detail:body}));}catch(e){body.innerHTML=`<div class="alert alert-danger">${e.message||'تعذر تحميل العينة.'}</div>`;}}));
</script>
}
