@model ViewModels.ExportCommitteeWorkVm
@{ViewData["Title"]=$"{Model.CommitteeType} - {Model.RequestNumber}";}
<style>
.work{direction:rtl;max-width:1350px;margin:24px auto;padding:18px}.head{background:linear-gradient(135deg,#176c70,#244f75);color:#fff;padding:20px;border-radius:14px;margin-bottom:18px}.head h2{margin:0 0 8px}.work-card{background:#fff;border:1px solid #dde7e9;border-radius:12px;padding:16px;margin-bottom:14px;box-shadow:0 4px 16px #173b4610}.lot-head{display:flex;justify-content:space-between;gap:12px;background:#f3f8f8;padding:10px;border-radius:8px;margin-bottom:14px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.grid label{font-weight:700;font-size:13px}.grid .form-control,.grid .form-select{margin-top:6px}.full{grid-column:1/-1}.actions{position:sticky;bottom:10px;background:#fff;border:1px solid #dce7e8;border-radius:12px;padding:14px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 5px 20px #0002}.finished{background:#edf7e8;color:#35751d;padding:12px;border-radius:9px}.member{background:#fff5d9;color:#7d5a00;padding:12px;border-radius:9px}@@media(max-width:800px){.grid{grid-template-columns:repeat(2,1fr)}}@@media(max-width:520px){.grid{grid-template-columns:1fr}.work{padding:8px}.actions{flex-direction:column;gap:10px}}
</style>
<main class="work">
<header class="head"><h2>@Model.CommitteeType</h2><div>طلب الصادر: <strong>@Model.RequestNumber</strong> — اللجنة: <strong>@Model.CommitteeId</strong></div></header>
@if(TempData["WorkSuccess"] is string ok){<div class="alert alert-success">@ok</div>}@if(TempData["WorkError"] is string err){<div class="alert alert-danger">@err</div>}
@if(Model.IsFinished){<div class="finished">تم إنهاء اللجنة والبيانات متاحة للعرض فقط.</div>}else if(!Model.IsAdmin){<div class="member">أنت عضو في اللجنة؛ سيتم تسجيل رأيك، والاعتماد والإنهاء متاحان لرئيس اللجنة.</div>}
<form asp-action="Save" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<input type="hidden" name="CommitteeId" value="@Model.CommitteeId" />
@for(var i=0;i<Model.Rows.Count;i++){var row=Model.Rows[i];<section class="work-card"><input type="hidden" name="Rows[@i].Id" value="@row.Id" /><div class="lot-head"><strong>@row.ItemName</strong><span>لوط: @(string.IsNullOrWhiteSpace(row.LotNumber)?"كلي":row.LotNumber) — العبوات: @(row.PackageCount?.ToString()??"—") — الوزن: @(row.OriginalWeight?.ToString("N3")??"—")</span><span class="badge @(row.IsTransferredToGenshi?"bg-success":"bg-secondary")">موقف اللوط: @(row.IsTransferredToGenshi?"تم تحويله إلى الجشني":"في مرحلة الفحص")</span></div>
@if(Model.CommitteeTypeId is 1 or 2){<div class="grid"><div><label>نتيجة الفحص</label><select name="Rows[@i].ResultTypeId" class="form-select" required><option value="">اختر</option>@foreach(var t in Model.ResultTypes){<option value="@t.Id" selected="@(row.ResultTypeId==t.Id)">@t.Name</option>}</select></div><div><label>العدد الفعلي</label><input name="Rows[@i].Quantity" type="number" step="0.001" class="form-control" value="@row.Quantity" /></div><div><label>الوزن الفعلي</label><input name="Rows[@i].Weight" type="number" step="0.001" class="form-control" value="@row.Weight" /></div><div><label>صورة الإصابة</label><input name="Rows[@i].InfectionPhoto" type="file" accept="image/*" capture="environment" class="form-control" /></div><div class="full"><label>الملاحظات / وصف الإصابة</label><textarea name="Rows[@i].Notes" class="form-control">@row.Notes</textarea></div></div>}
else if(Model.CommitteeTypeId==3){<div class="grid"><div><label>نوع التحليل</label><input class="form-control" value="@row.AnalysisName" readonly /></div><div><label>تاريخ السحب</label><input name="Rows[@i].WithdrawDate" type="date" class="form-control" value="@row.WithdrawDate?.ToString("yyyy-MM-dd")" required /></div><div><label>باركود العينة</label><input name="Rows[@i].Barcode" class="form-control" value="@row.Barcode" required /></div><div><label>حجم العينة</label><input name="Rows[@i].SampleSize" type="number" step="0.001" class="form-control" value="@row.SampleSize" required /></div><div><label>نسبة العينة</label><input name="Rows[@i].SampleRatio" type="number" step="0.001" class="form-control" value="@row.SampleRatio" /></div><div><label>الرأي</label><select name="Rows[@i].IsAccepted" class="form-select"><option value="">لم تحدد</option><option value="true" selected="@(row.IsAccepted==true)">مقبول</option><option value="false" selected="@(row.IsAccepted==false)">مرفوض</option></select></div><div class="full"><label>ملاحظات السحب</label><textarea name="Rows[@i].Notes" class="form-control">@row.Notes</textarea></div></div>}
else if(Model.CommitteeTypeId==6){<div class="grid"><div><label>طريقة المعالجة</label><input class="form-control" value="@row.TreatmentMethod" readonly /></div><div><label>حجم المعالجة</label><input name="Rows[@i].TreatmentSize" type="number" step="0.001" class="form-control" value="@row.TreatmentSize" required /></div><div><label>كمية المادة</label><input name="Rows[@i].MaterialAmount" type="number" step="0.001" class="form-control" value="@row.MaterialAmount" /></div><div><label>الجرعة</label><input name="Rows[@i].Dose" type="number" step="0.001" class="form-control" value="@row.Dose" /></div><div><label>الدقائق</label><input name="Rows[@i].ExposureMinute" type="number" class="form-control" value="@row.ExposureMinute" /></div><div><label>الساعات</label><input name="Rows[@i].ExposureHour" type="number" class="form-control" value="@row.ExposureHour" /></div><div><label>الأيام</label><input name="Rows[@i].ExposureDay" type="number" class="form-control" value="@row.ExposureDay" /></div><div><label>درجة الحرارة</label><input name="Rows[@i].Temperature" type="number" step="0.01" class="form-control" value="@row.Temperature" /></div><div class="full"><label>إجراءات المعالجة</label><textarea name="Rows[@i].Procedures" class="form-control">@row.Procedures</textarea></div><div class="full"><label>ملاحظات</label><textarea name="Rows[@i].Notes" class="form-control">@row.Notes</textarea></div></div>}
</section>}
@if(Model.Rows.Count==0){<div class="alert alert-warning">لا توجد لوطات أو سجلات مجهزة لهذه اللجنة.</div>}
<div class="actions"><a asp-controller="ListEXCheckRequest" asp-action="Details" asp-route-id="@Model.RequestId" class="btn btn-outline-secondary">العودة للطلب</a>@if(!Model.IsFinished&&Model.Rows.Count>0){<div>@if(Model.IsAdmin){<label><input type="checkbox" name="FinishCommittee" value="true" /> إنهاء اللجنة بعد الحفظ</label>}<button class="btn btn-success mx-2" type="submit">@(Model.IsAdmin?"حفظ بيانات اللجنة":"تسجيل رأيي")</button></div>}</div>
</form></main>
