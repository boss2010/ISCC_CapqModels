@model List<PlantMobile.Models.CheckRequestOutletRowVm>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "طلبات فحص مرتبطة بالمنفذ";
    var options = ViewBag.OutletOptions as List<PlantMobile.Models.PortOptionVm> ?? new List<PlantMobile.Models.PortOptionVm>();
    var noPort = ViewBag.NoPort is true;
    var rows = Model ?? new List<PlantMobile.Models.CheckRequestOutletRowVm>();
}
<style>
    .outlet-page { direction: rtl; max-width: 1500px; margin: 0 auto; padding: 28px 18px; color: #25343b; }
    .outlet-page h2 { color: #246b70; margin: 0; font-weight: 800; }
    .outlet-table-card { background:#fff; border:1px solid #e5ecef; border-radius:16px; box-shadow:0 6px 22px rgba(28,52,65,.07); overflow:hidden; }
    .outlet-table { margin: 0; }
    .outlet-table thead { background: #287f82; color: #fff; }
    .outlet-table thead th, .outlet-table td { padding: 12px 9px; border: 0; text-align: center; }
    .outlet-table tbody tr:nth-child(even) td { background: #f8fafb; }
    .outlet-table tbody tr:hover td { background: #eef8f8; }
    .action-link { display:inline-block; color:#21777a; background:#e8f5f5; border-radius:7px; padding:6px 12px; font-weight:700; text-decoration:none; }
    .save-button { background:#1e7c80 !important; color:#fff !important; border:2px solid #1e8084 !important; box-shadow:0 4px #1d9fa5 !important; border-radius:8px; padding:10px 28px; font-weight:800; }
    .save-button:hover { background:#1a8488 !important; box-shadow:0 4px #1d9fa5 !important; }
</style>
<form id="antiforgeryOutletForm" method="post">@Html.AntiForgeryToken()</form>
<div class="outlet-page">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>طلبات الفحص المرتبطة بالمنفذ</h2>
        <a asp-controller="ImportRequests" asp-action="Index" class="btn btn-outline-secondary">العودة للطلبات</a>
    </div>

    @if (noPort)
    {
        <div class="alert alert-warning">
            @(ViewBag.LoadError as string ?? "لا يوجد ميناء على المنفذ الخاص بالمستخدم برجاء مراجعة الإدارة")
        </div>
    }
    else if (!rows.Any())
    {
        <div class="alert alert-info">لا توجد طلبات حاليًا مرتبطة بمينائك.</div>
    }
    else
    {
        <div class="outlet-table-card">
            <div class="table-responsive">
                <table class="table outlet-table" id="tblCheckLst">
                    <thead>
                        <tr class="label-primary">
                            <td hidden></td>
                            <th>رقم طلب الفحص</th>
                            <th>ميناء محلي</th>
                            <th>المحافظة</th>
                            <td hidden></td>
                            <th>اختيار المنفذ</th>
                        </tr>
                    </thead>
                    <tbody id="mybody">
                        @foreach (var item in rows.OrderBy(x => x.ID))
                        {
                            <tr>
                                <td hidden>@item.ID</td>
                                <td>
                                    <a class="action-link"
                                       href="/Im_CheckRequests/Im_CheckRequestDisplay/Index?ImCheckRequest_Number=@Uri.EscapeDataString(item.ImCheckRequest_Number)">
                                        @item.ImCheckRequest_Number
                                    </a>
                                </td>
                                <td>@item.Port_Name</td>
                                <td>@item.Gov_Name</td>
                                <td hidden>@item.Gov_ID</td>
                                <td id="ImportIdtd_@item.ID">
                                    <select id="@item.ID" name="ImportId" class="form-control">
                                        @foreach (var option in options)
                                        {
                                            <option value="@(option.Value?.ToString() ?? "")">@option.DisplayText</option>
                                        }
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-4"></div>
            <div class="col-md-4"></div>
            <div class="col-md-4 text-align-center">
                <button type="button" onclick="updateUserPass()" class="save-button">حفظ</button>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    var verificationToken = $('input[name="__RequestVerificationToken"]').val();

    function updateUserPass() {
        var rows = document.getElementById('mybody').rows;
        var payload = [];

        for (var i = 0; i < rows.length; i++) {
            var cells = rows[i].getElementsByTagName('td');
            var id = cells[0].textContent.trim();
            if (!id) continue;

            var selected = $('#ImportIdtd_' + id + ' select').val();
            if (selected && Number(selected) > 0) {
                payload.push({ ID: Number(id), Outlet_ID: Number(selected) });
            }
        }

        if (!payload.length) {
            alert('اختر منفذًا واحدًا على الأقل للحفظ');
            return;
        }

        $.ajax({
            url: '@Url.Action("Update_Check_Outlet", "List_ImCheckRequestOutlet")',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            headers: { RequestVerificationToken: verificationToken },
            data: JSON.stringify({ model: payload }),
            dataType: 'json',
            success: function () {
                alert('تم الحفظ بنجاح');
                location.reload();
            },
            error: function (xhr) {
                var response = xhr.responseJSON;
                alert((response && (response.Message || response.message)) || 'خطأ فى اضافه اللوطات');
            }
        });
    }
</script>
}
