@{ ViewData["Title"]="نتيجة المعمل"; }
<style>
 .lab-shell{max-width:920px;margin:auto}.scan-card{border:1px solid #d9e8e8;border-radius:18px;background:#fff;box-shadow:0 7px 24px rgba(31,78,82,.08)}
 .scan-actions{display:grid;grid-template-columns:1fr auto;gap:10px}.scanner{background:#102728;border-radius:14px;overflow:hidden;position:relative}.scanner video{display:block;width:100%;max-height:380px;object-fit:cover}.scanner-line{position:absolute;left:10%;right:10%;top:50%;border-top:3px solid #ffc107}
 .lab-summary{display:grid;grid-template-columns:1fr 1fr;gap:10px}.lab-summary div{border:1px solid #dce8e8;border-radius:10px;padding:10px}.lab-summary span,.lab-summary strong{display:block}.lab-summary span{color:#6c7e80;font-size:.85rem}
 @@media(max-width:600px){.scan-actions,.lab-summary{grid-template-columns:1fr}}
</style>
<div class="container py-4" dir="rtl"><div class="lab-shell">
 <div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="text-primary mb-1">نتيجة المعمل</h2><div class="text-muted">امسح باركود أو QR Code للعينة، أو أدخله يدويًا</div></div><a asp-controller="ImportRequests" asp-action="Index" class="btn btn-outline-secondary">طلبات الوارد</a></div>
 <section class="scan-card p-3 mb-3"><div class="scan-actions"><input id="sampleCode" class="form-control form-control-lg" placeholder="رقم باركود العينة" autocomplete="off" /><button id="findSample" class="btn btn-primary px-4">فتح النتيجة</button></div><div class="d-flex flex-wrap gap-2 mt-3"><button id="startScanner" class="btn btn-outline-primary" type="button"><i class="fas fa-qrcode"></i> تشغيل قارئ الكود</button><label class="btn btn-outline-secondary mb-0"><i class="fas fa-image"></i> قراءة كود من صورة<input id="codeImage" type="file" accept="image/*" hidden /></label></div><div id="scanner" class="scanner mt-3 d-none"><video id="scannerVideo" playsinline muted></video><span class="scanner-line"></span></div><div id="scanMessage" class="small text-muted mt-2"></div></section>
 <section id="resultHost"></section>
</div></div>
@section Scripts { <script src="~/lib/zxing/zxing-browser.min.js"></script><script src="~/js/laboratory-result.js" ></script> }
