@model ViewModels.EmployeeStationAssignmentPageVm
@{ViewData["Title"]="تسكين الموظفين بالمحطات";}
<style>
    .assignment-page{direction:rtl;max-width:1400px;margin:auto;padding:28px 18px}.page-title{margin-bottom:20px}.page-title h2{color:#246f73;font-weight:800;margin:0}.page-title p{color:#71838a;margin:6px 0}.assignment-card{background:#fff;border:1px solid #e2eaed;border-radius:15px;box-shadow:0 6px 22px rgba(27,61,68,.07);margin-bottom:20px;overflow:visible}.card-title{background:#eff8f8;color:#246f73;font-size:18px;font-weight:800;padding:15px 20px}.assignment-form{padding:20px;display:grid;grid-template-columns:repeat(5,1fr);gap:14px;align-items:end}.assignment-form label{display:block;font-weight:700;margin-bottom:7px}.assignment-form .form-control{height:42px;border-radius:8px}.assignment-form .btn{height:42px;border-radius:8px}.search-select-wrap{position:relative;width:100%}.search-select-button{width:100%;height:42px;padding:7px 12px;border:1px solid #ced4da;border-radius:8px;background:#fff;color:#495057;text-align:right;display:flex;align-items:center;justify-content:space-between}.search-select-button:after{content:'▾';margin-right:8px}.search-select-button:disabled{background:#e9ecef;color:#6c757d}.search-select-panel{position:absolute;z-index:1050;top:calc(100% + 3px);right:0;left:0;background:#fff;border:1px solid #ced4da;border-radius:8px;box-shadow:0 6px 18px rgba(0,0,0,.15);padding:8px;display:none}.search-select-wrap.open .search-select-panel{display:block}.search-select-input{width:100%;height:38px;border:1px solid #ced4da;border-radius:6px;padding:6px 10px;direction:rtl;text-align:right;margin-bottom:6px}.search-select-options{max-height:230px;overflow-y:auto}.search-select-option{display:block;width:100%;border:0;background:#fff;text-align:right;padding:8px 10px;border-radius:5px}.search-select-option:hover,.search-select-option.selected{background:#eaf6f6;color:#246f73}.search-select-empty{padding:10px;color:#788;text-align:center}.employee-hint{padding:0 20px 18px;color:#73858c}.assignment-table th,.assignment-table td{text-align:center;vertical-align:middle}.assignment-table thead{background:#287f82;color:#fff}.assignment-table th{border:0!important}.empty{padding:35px!important;color:#75868c}.period{white-space:nowrap}.delete-btn{border:0;border-radius:7px;padding:6px 11px;background:#fde9eb;color:#a5333d}.filter-row{padding:15px 20px;border-bottom:1px solid #e7edef;display:flex;justify-content:space-between;align-items:center}.filter-row .search-select-wrap{width:360px;max-width:100%}.alert-wrap{margin-bottom:15px}.status-current{color:#19764a;font-weight:700}.status-old{color:#7a858a}
    @@media(max-width:950px){.assignment-form{grid-template-columns:repeat(2,1fr)}}@@media(max-width:550px){.assignment-page{padding:16px 10px}.assignment-form{grid-template-columns:1fr}.filter-row{align-items:stretch;flex-direction:column;gap:10px}.filter-row select{max-width:none}}
</style>
<div class="assignment-page">
    <div class="page-title"><h2>تسكين الموظفين بالمحطات</h2><p>اختر المنفذ والموظف والمحطة وحدد فترة التسكين</p></div>
    <div class="alert-wrap">@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}</div>
    <section class="assignment-card"><div class="card-title">إضافة تسكين جديد</div><form asp-action="Save" method="post" class="assignment-form" id="assignmentForm">@Html.AntiForgeryToken()
        <div><label for="outletId">المنفذ</label><select id="outletId" name="outletId" class="form-control searchable-select" data-search-placeholder="ابحث عن المنفذ..." required><option value="">اختر المنفذ</option>@foreach(var item in Model.Outlets){<option value="@item.Id" selected="@(Model.OutletId==item.Id)">@item.Text</option>}</select></div>
        <div><label for="employeeUserId">الموظف</label><select id="employeeUserId" name="employeeUserId" class="form-control searchable-select" data-search-placeholder="ابحث بالاسم أو الرقم..." required disabled><option value="">اختر المنفذ أولًا</option></select></div>
        <div><label for="stationId">المحطة</label><select id="stationId" name="stationId" class="form-control searchable-select" data-search-placeholder="ابحث عن المحطة..." required><option value="">اختر المحطة</option>@foreach(var item in Model.Stations){<option value="@item.Id">@item.Text</option>}</select></div>
        <div><label for="fromDate">من تاريخ</label><input id="fromDate" name="fromDate" type="date" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" required /></div>
        <div><label for="toDate">إلى تاريخ</label><input id="toDate" name="toDate" type="date" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" required /></div>
        <div style="grid-column:1/-1;text-align:center"><button type="submit" class="btn btn-primary" style="min-width:170px">حفظ التسكين</button></div>
    </form><div id="employeeHint" class="employee-hint">سيظهر موظفو المنفذ بعد اختياره.</div></section>
    <section class="assignment-card" id="employeeHistoryCard" hidden><div class="card-title">بيانات التسكين السابقة للموظف المختار</div><div class="table-responsive"><table class="table assignment-table"><thead><tr><th>الموظف</th><th>الرقم الوظيفي</th><th>المنفذ</th><th>المحطة</th><th>الفترة</th><th>الحالة</th></tr></thead><tbody id="employeeHistoryBody"></tbody></table></div></section>
    <section class="assignment-card"><div class="filter-row"><strong>التسكينات الحالية</strong><select id="listOutletFilter" class="form-control searchable-select" data-search-placeholder="ابحث عن المنفذ..."><option value="">كل المنافذ</option>@foreach(var item in Model.Outlets){<option value="@item.Id" selected="@(Model.OutletId==item.Id)">@item.Text</option>}</select></div><div class="table-responsive"><table class="table assignment-table"><thead><tr><th>الموظف</th><th>الرقم الوظيفي</th><th>المنفذ</th><th>المحطة</th><th>الفترة</th><th>إلغاء</th></tr></thead><tbody>@if(Model.Assignments.Count==0){<tr><td colspan="6" class="empty">لا توجد تسكينات حالية</td></tr>}@foreach(var row in Model.Assignments){<tr><td>@row.EmployeeName</td><td>@(row.EmployeeId?.ToString()??"—")</td><td>@row.OutletName</td><td>@row.StationName</td><td class="period">@row.FromDate.ToString("dd/MM/yyyy") — @row.ToDate.ToString("dd/MM/yyyy")</td><td><form asp-action="Delete" asp-route-id="@row.Id" method="post" onsubmit="return confirm('هل تريد إلغاء هذا التسكين؟');">@Html.AntiForgeryToken()<input type="hidden" name="outletId" value="@Model.OutletId"/><button class="delete-btn" type="submit">إلغاء</button></form></td></tr>}</tbody></table></div></section>
</div>
@section Scripts{<script>
$(function(){
 function createSearchableSelect(select){var $select=$(select),wrap=$('<div class="search-select-wrap">'),button=$('<button type="button" class="search-select-button">'),panel=$('<div class="search-select-panel">'),search=$('<input type="search" class="search-select-input">').attr('placeholder',$select.data('search-placeholder')||'ابحث...'),options=$('<div class="search-select-options">');$select.after(wrap).appendTo(wrap).hide();wrap.append(button,panel.append(search,options));function refresh(){var selected=$select.find('option:selected'),query=(search.val()||'').trim().toLowerCase();button.text(selected.text()||$select.find('option:first').text()).prop('disabled',$select.prop('disabled'));options.empty();var count=0;$select.find('option').each(function(){var option=$(this),text=option.text();if(query&&text.toLowerCase().indexOf(query)===-1)return;count++;$('<button type="button" class="search-select-option">').toggleClass('selected',option.prop('selected')).text(text).on('click',function(){$select.val(option.val()).trigger('change');wrap.removeClass('open');search.val('');refresh();}).appendTo(options);});if(!count)options.append('<div class="search-select-empty">لا توجد نتائج</div>');}button.on('click',function(){if(button.prop('disabled'))return;$('.search-select-wrap').not(wrap).removeClass('open');wrap.toggleClass('open');if(wrap.hasClass('open')){search.val('');refresh();search.trigger('focus');}});search.on('input',refresh);$select.on('searchable:refresh',refresh);refresh();}
 $('.searchable-select').each(function(){createSearchableSelect(this);});
 var outlet=$('#outletId'),employee=$('#employeeUserId'),hint=$('#employeeHint'),historyCard=$('#employeeHistoryCard'),historyBody=$('#employeeHistoryBody');
 $(document).on('click',function(e){if(!$(e.target).closest('.search-select-wrap').length)$('.search-select-wrap').removeClass('open');});
 function hideHistory(){historyCard.prop('hidden',true);historyBody.empty();}
 function loadHistory(){var employeeId=employee.val();hideHistory();if(!employeeId)return;historyCard.prop('hidden',false);historyBody.html('<tr><td colspan="6" class="empty">جاري تحميل البيانات السابقة...</td></tr>');$.getJSON('@Url.Action("EmployeeHistory")',{employeeUserId:employeeId}).done(function(items){historyBody.empty();if(!items.length){historyBody.html('<tr><td colspan="6" class="empty">لا توجد تسكينات سابقة لهذا الموظف</td></tr>');return;}$.each(items,function(_,item){var row=$('<tr>');$('<td>').text(item.employeeName).appendTo(row);$('<td>').text(item.employeeId||'—').appendTo(row);$('<td>').text(item.outletName).appendTo(row);$('<td>').text(item.stationName).appendTo(row);$('<td>').addClass('period').text(formatDate(item.fromDate)+' — '+formatDate(item.toDate)).appendTo(row);$('<td>').addClass(item.isActive?'status-current':'status-old').text(item.isActive?'حالي':'سابق').appendTo(row);historyBody.append(row);});}).fail(function(){historyBody.html('<tr><td colspan="6" class="empty">تعذر تحميل بيانات الموظف السابقة</td></tr>');});}
 function formatDate(value){var parts=value.split('-');return parts.length===3?parts[2]+'/'+parts[1]+'/'+parts[0]:value;}
 function loadEmployees(){var id=outlet.val(),selectedEmployee=employee.val();hideHistory();employee.prop('disabled',true).html('<option value="">جاري التحميل...</option>').trigger('searchable:refresh');if(!id){employee.html('<option value="">اختر المنفذ أولًا</option>').trigger('searchable:refresh');hint.text('سيظهر موظفو المنفذ بعد اختياره.');return;}$.getJSON('@Url.Action("Employees")',{outletId:id}).done(function(items){employee.empty().append('<option value="">اختر الموظف</option>');$.each(items,function(_,item){employee.append($('<option>').val(item.id).text(item.name+(item.employeeId?' — '+item.employeeId:'')));});employee.prop('disabled',false);if(selectedEmployee&&employee.find('option[value="'+selectedEmployee+'"]').length){employee.val(selectedEmployee);loadHistory();}employee.trigger('searchable:refresh');hint.text(items.length?'تم تحميل '+items.length+' موظفًا تابعًا للمنفذ. اختر موظفًا لعرض بياناته السابقة.':'لا يوجد موظفون مسجلون على هذا المنفذ.');}).fail(function(){employee.html('<option value="">تعذر تحميل الموظفين</option>').trigger('searchable:refresh');hint.text('حدث خطأ أثناء تحميل الموظفين.');});}
 outlet.on('change',loadEmployees);if(outlet.val())loadEmployees();
 employee.on('change',loadHistory);
 $('#listOutletFilter').on('change',function(){var value=$(this).val(),url='@Url.Action("Index")';window.location.href=value?url+'?outletId='+encodeURIComponent(value):url;});
 $('#assignmentForm').on('submit',function(e){if($('#fromDate').val()>$('#toDate').val()){e.preventDefault();alert('تاريخ البداية يجب أن يسبق تاريخ النهاية.');}});
});
</script>}
