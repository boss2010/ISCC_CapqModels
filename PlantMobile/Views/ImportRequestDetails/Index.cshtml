                                    </div>
                                    <div class="inspection-field inspection-field-notes">
                                        <label class="form-label fw-bold">الملاحظات</label>
                                        <textarea class="form-control" rows="3" name="Samples[@sampleIndex].Notes" placeholder="اكتب ملاحظات نتيجة السحب هنا..." required disabled="@isWorkReadOnly">@sample.Notes_Ar</textarea>
                                    </div>
                                </div>
                            </div>
                        }
