                                <div class="inspection-field inspection-field-notes"><label class="form-label fw-bold">الملاحظات</label><textarea class="form-control" rows="2" name="Samples[@sampleIndex].Notes" placeholder="اكتب ملاحظات السحب..." required disabled="@(!Model.IsAdmin || isWorkReadOnly)">@sample.Notes_Ar</textarea></div>
