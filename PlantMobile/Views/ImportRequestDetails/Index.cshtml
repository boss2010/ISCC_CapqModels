                            <div class="inspection-panel">
                                <div class="inspection-fields">
                                    <div class="inspection-field"><label class="form-label fw-bold">حجم الرسالة (م³)</label><input class="form-control" type="number" step="0.001" min="0.001" name="Records[@treatmentIndex].Size" value="@treatment.size" required readonly="@(isWorkReadOnly || !Model.IsAdmin)" /></div>
                                    <div class="inspection-field"><label class="form-label fw-bold">كمية المادة</label><input class="form-control" type="number" step="0.001" min="0.001" name="Records[@treatmentIndex].MaterialAmount" value="@treatment.treatmentMat_Amount" required readonly="@(isWorkReadOnly || !Model.IsAdmin)" /></div>
                                    <div class="inspection-field"><label class="form-label fw-bold">الجرعة (جم/م³)</label><input class="form-control" type="number" step="0.001" min="0.001" name="Records[@treatmentIndex].Dose" value="@treatment.dose" required readonly="@(isWorkReadOnly || !Model.IsAdmin)" /></div>
                                    <div class="inspection-field"><label class="form-label fw-bold">درجة الحرارة (°م)</label><input class="form-control" type="number" step="0.01" name="Records[@treatmentIndex].Temperature" value="@treatment.temperature" readonly="@(isWorkReadOnly || !Model.IsAdmin)" /></div>
                                    <div class="inspection-field"><label class="form-label fw-bold">رقم الختم الحراري</label><input class="form-control" type="number" step="1" name="Records[@treatmentIndex].ThermalSealNumber" value="@treatment.thermalSealNumber" readonly="@(isWorkReadOnly || !Model.IsAdmin)" /></div>
                                    <div class="inspection-field">
                                        <label class="form-label fw-bold">مدة التعرض</label>
                                        <div class="d-flex gap-2">
                                            <div class="input-group"><input class="form-control" type="number" min="0" name="Records[@treatmentIndex].ExposureDay" value="@(treatment.exposure_Day ?? 0)" required readonly="@(isWorkReadOnly || !Model.IsAdmin)" /><span class="input-group-text">يوم</span></div>
                                            <div class="input-group"><input class="form-control" type="number" min="0" max="23" name="Records[@treatmentIndex].ExposureHour" value="@(treatment.exposure_Hour ?? 0)" required readonly="@(isWorkReadOnly || !Model.IsAdmin)" /><span class="input-group-text">س</span></div>
                                            <div class="input-group"><input class="form-control" type="number" min="0" max="59" name="Records[@treatmentIndex].ExposureMinute" value="@(treatment.exposure_Minute ?? 0)" required readonly="@(isWorkReadOnly || !Model.IsAdmin)" /><span class="input-group-text">د</span></div>
                                        </div>
                                    </div>
                                    <div class="inspection-field inspection-field-notes"><label class="form-label fw-bold">إضافة تعليق</label><textarea class="form-control" name="Records[@treatmentIndex].Notes" rows="3" readonly="@(isWorkReadOnly || !Model.IsAdmin)">@treatment.Notes</textarea></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    treatmentIndex++;
                }
            }
            @if (treatmentIndex == 0)
            {
                <div class="alert alert-warning text-center">لا توجد سجلات معالجة مجهزة لهذه اللجنة.</div>
            }
            @if (Model.IsAdmin && !isWorkReadOnly && treatmentIndex > 0)
            {
                <div class="card shadow-sm mb-4"><div class="card-body d-flex justify-content-between align-items-center save-bar">
                    <div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="IsFinishedAll" value="true" id="finishTreatment" checked /><label class="form-check-label fw-bold" for="finishTreatment">إنهاء لجنة المعالجة بعد الحفظ</label></div>
                    <div class="d-flex gap-2"><a asp-controller="ImportRequests" asp-action="Index" class="btn btn-outline-secondary px-4">إلغاء</a><button type="submit" class="btn btn-success px-5" id="saveTreatmentButton">حفظ بيان المعالجة</button></div>
                </div></div>
            }
        </form>
    }
    else
    {
        @foreach (var item in details.Item_Data)
        {
            <div class="card shadow-sm mb-3"><div class="card-header"><strong>@item.Item_Name — @item.Item_ShortName_Name</strong></div><div class="card-body">
                <div><strong>الاسم العلمي:</strong> @item.Scientific_Name</div>
                @if (Model.CommitteeTypeId == 14 && item.TreatmentLot?.Any() == true) { <hr /><div class="alert alert-secondary">عدد سجلات المعالجة: @item.TreatmentLot.Count()</div> }
            </div></div>
        }
    }
</div>

@section Scripts {
    <script src="~/js/weight-units.js" ></script>
    <script>
        (() => {
            const treatmentForm = document.getElementById('treatmentSaveForm');
            const treatmentButton = document.getElementById('saveTreatmentButton');
            const treatmentApplyToAll = document.getElementById('treatmentApplyToAll');
            document.querySelectorAll('input[name="TreatmentModeChoice"]').forEach(mode => mode.addEventListener('change', () => {
                if (treatmentApplyToAll) treatmentApplyToAll.value = mode.value === 'total' ? 'true' : 'false';
                document.querySelectorAll('.treatment-record').forEach((card, index) => {
                    card.style.display = mode.value === 'total' && index > 0 ? 'none' : '';
                    card.querySelectorAll('input,textarea,select').forEach(input => {
                        if (input.name !== 'Records[0].TreatmentDataId') input.disabled = mode.value === 'total' && index > 0;
                    });
                });
            }));
            treatmentForm?.addEventListener('submit', () => {
                if (!treatmentForm.checkValidity() || !treatmentButton) return;
                treatmentButton.disabled = true;
                treatmentButton.textContent = 'جارٍ حفظ بيان المعالجة...';
            });
            document.querySelector('input[name="TreatmentModeChoice"]:checked')?.dispatchEvent(new Event('change'));

            const withdrawalSection = document.getElementById('withdrawalSection');
            const inspectionForm = document.getElementById('inspectionSaveForm');
            function bindInspectionSamples(root) {
                if (!inspectionForm || document.getElementById('performWithdrawal')?.value !== 'true') return;
                root?.querySelectorAll('[name^="Samples["]').forEach(field => field.setAttribute('form', 'inspectionSaveForm'));
            }
document.getElementById('openWithdrawal')?.addEventListener('click', () => {
 document.getElementById('performWithdrawal').value = 'true';
 bindInspectionSamples(withdrawalSection);
 if (withdrawalSection) { withdrawalSection.style.display = ''; withdrawalSection.scrollIntoView({behavior:'smooth'}); document.getElementById('sampleLot')?.focus({preventScroll:true}); }
});
            const samplesForm = document.getElementById('samplesSaveForm');
            bindInspectionSamples(samplesForm);
            const samplesButton = document.getElementById('saveSamplesButton');
            const analysisLabOptions = @Html.Raw(analysisLabOptionsJson);
            const analysisTypeSelect = document.getElementById('sampleAnalysisType');
            const analysisLabSelect = document.getElementById('sampleAnalysisLab');
            const sampleLotSelect = document.getElementById('sampleLot');
            const withdrawalModes = document.querySelectorAll('input[name="WithdrawalModeChoice"]');
            const isTotalWithdrawal = () => document.querySelector('input[name="WithdrawalModeChoice"]:checked')?.value === 'total';
            const existingMode = document.getElementById('existingWithdrawalMode');
            const sharedFields = document.getElementById('sharedWithdrawalFields');
            const assignedCards = () => [...(samplesForm?.querySelectorAll('.sample-result-card') ?? [])].filter(card => card.dataset.sampleAttached !== 'true');
            function syncAssignedWithdrawal() {
                if (!existingMode) return;
                const total = isTotalWithdrawal();
                sharedFields.hidden = !total;
                sharedFields.style.display = total ? '' : 'none';
                const amount = document.getElementById('newSampleSize');
                const seal = document.getElementById('newSampleSeal');
                const notes = document.getElementById('newSampleNotes');
                amount.required = total; notes.required = total;
                assignedCards().forEach(card => {
                    card.querySelector('input[name$=".IsTotal"]').value = String(total);
                    const size = card.querySelector('input[name$=".SampleSize"]');
                    const sampleSeal = card.querySelector('input[name$=".SealNumber"]');
                    const sampleNotes = card.querySelector('textarea[name$=".Notes"]');
                    [size,sampleSeal,sampleNotes].forEach(field => { if (field) field.readOnly = total; });
                    const unit = size.closest('.weight-editor')?.querySelector('select');
                    if (unit) unit.disabled = total;
                    if (!total) return;
                    const count = amount.dataset.quantityUnit === 'count';
                    if (unit) { unit.value = count ? 'count' : '1'; unit.dispatchEvent(new Event('change', {bubbles:true})); }
                    size.value = amount.value === '' ? '' : String(Number(amount.value) * Number(amount.dataset.weightFactor || 1));
                    size.dataset.quantityUnit = count ? 'count' : 'kg'; size.dataset.weightFactor = '1';
                    size.min = count ? '1' : '0.001'; size.step = count ? '1' : '0.001';
                    if (sampleSeal) sampleSeal.value = seal.value;
                    if (sampleNotes) sampleNotes.value = notes.value;
                });
            }
            if (existingMode) {
                const first = assignedCards()[0];
                if (first && isTotalWithdrawal()) {
                    const amount = document.getElementById('newSampleSize');
                    const source = first.querySelector('input[name$=".SampleSize"]');
                    const unit = amount.closest('.weight-editor')?.querySelector('select');
                    if (unit) { unit.value = source.dataset.quantityUnit === 'count' ? 'count' : '1'; unit.dispatchEvent(new Event('change', {bubbles:true})); }
                    amount.value = source.value;
                    document.getElementById('newSampleSeal').value = first.querySelector('input[name$=".SealNumber"]')?.value ?? '';
                    document.getElementById('newSampleNotes').value = first.querySelector('textarea[name$=".Notes"]')?.value ?? '';
                }
                sharedFields.addEventListener('input', syncAssignedWithdrawal);
                sharedFields.addEventListener('change', syncAssignedWithdrawal);
                syncAssignedWithdrawal();
            }
            if (sampleLotSelect) sampleLotSelect.disabled = isTotalWithdrawal();
            withdrawalModes.forEach(mode => mode.addEventListener('change', () => {
                if (sampleLotSelect) sampleLotSelect.disabled = isTotalWithdrawal();
                syncAssignedWithdrawal();
            }));
            const newSamplesContainer = document.getElementById('newSamplesContainer');
            let nextSampleIndex = samplesForm?.querySelectorAll('input[name$=".SampleId"]').length ?? 0;
            const escapeHtml = value => String(value ?? '').replace(/[&<>'"]/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' })[char]);
                    const formatWeight = value => {
            const number = Number(value);

            if (!Number.isFinite(number)) {
                return '—';
            }

            return number.toLocaleString('en-US', {
                minimumFractionDigits: 0,
                maximumFractionDigits: 6
            });
        };

            if (analysisTypeSelect) {
                [...new Map(analysisLabOptions.map(x => [x.AnalysisTypeId, x.AnalysisTypeName])).entries()]
                    .forEach(([id, name]) => analysisTypeSelect.add(new Option(name, id)));
                analysisTypeSelect.addEventListener('change', () => {
                    analysisLabSelect.innerHTML = '<option value="">— اختر معمل التحليل —</option>';
                    analysisLabOptions.filter(x => String(x.AnalysisTypeId) === analysisTypeSelect.value)
                        .forEach(x => analysisLabSelect.add(new Option(x.AnalysisLabName, x.AnalysisLabTypeId)));
                    analysisLabSelect.disabled = !analysisTypeSelect.value;
                });
            }

            document.getElementById('addSampleAnalysis')?.addEventListener('click', () => {
                const totalWithdrawal = isTotalWithdrawal();
                const selectedLots = totalWithdrawal ? [...(sampleLotSelect?.options ?? [])].filter(option => option.value)
                    : [...(sampleLotSelect?.selectedOptions ?? [])].filter(option => option.value);
                const labOption = analysisLabSelect?.selectedOptions[0];
                if (!selectedLots.length || !analysisTypeSelect?.value || !labOption?.value || !newSamplesContainer || !samplesForm) {
                    alert('يجب اختيار اللوط ونوع التحليل ومعمل التحليل.');
                    return;
                }
const draftSize=document.getElementById('newSampleSize'),draftSeal=document.getElementById('newSampleSeal'),draftNotes=document.getElementById('newSampleNotes');
if (!draftSize.value || !draftSize.checkValidity() || !draftSeal.value.trim() || !draftNotes.value.trim()) { alert('استكمل كمية العينة ورقم الختم أو الرصاصة والملاحظات قبل الإضافة.'); return; }
const sampleKg=Number(draftSize.value)*Number(draftSize.dataset.weightFactor || 1);
const sampleUnit=draftSize.dataset.quantityUnit === 'count' ? 'count' : 'kg';
                const findExistingSample = lot => samplesForm.querySelector(`[data-sample-key="${lot.value}-${labOption.value}"]`)
                    ?? (totalWithdrawal ? samplesForm.querySelector(`[data-sample-key="-${labOption.value}"][data-sample-item="${lot.dataset.requestItem}"]`) : null);
                if (selectedLots.some(lot => findExistingSample(lot)?.dataset.sampleAttached === 'true')) {
                    alert('لا يمكن تعديل عينة لها نتيجة معمل محفوظة.');
                    return;
                }
                for (const lotOption of selectedLots) {
                const key = `${lotOption.value}-${labOption.value}`;
                const existingCard = findExistingSample(lotOption);
                if (existingCard) {
                    const size = existingCard.querySelector('input[name$=".SampleSize"]');
                    const unit = size.closest('.weight-editor')?.querySelector('select');
                    if (unit) { unit.value = sampleUnit === 'count' ? 'count' : '1'; unit.dispatchEvent(new Event('change', {bubbles:true})); }
                    size.value = String(sampleKg);
                    size.dataset.quantityUnit = sampleUnit;
                    size.dataset.weightFactor = '1';
                    existingCard.querySelector('input[name$=".SealNumber"]').value = draftSeal.value.trim();
                    existingCard.querySelector('textarea[name$=".Notes"]').value = draftNotes.value.trim();
                    existingCard.querySelector('input[name$=".IsTotal"]').value = String(totalWithdrawal);
                    existingCard.setAttribute('open', 'open');
                    bindInspectionSamples(existingCard);
                    continue;
                }
                const index = nextSampleIndex++;
                const card = document.createElement('div');
                card.className = 'inspection-panel shadow-sm mb-3';
                card.dataset.sampleKey = key;
                card.innerHTML = `
                    <input type="hidden" name="Samples[${index}].SampleId" value="0" />
                    <input type="hidden" name="Samples[${index}].IsTotal" value="${totalWithdrawal}" />
                    <input type="hidden" name="Samples[${index}].LotDataId" value="${lotOption.value}" />
                    <input type="hidden" name="Samples[${index}].RequestItemId" value="${lotOption.dataset.requestItem}" />
                    <input type="hidden" name="Samples[${index}].ItemShortNameId" value="${lotOption.dataset.shortName}" />
                    <input type="hidden" name="Samples[${index}].AnalysisLabTypeId" value="${labOption.value}" />
                    <input type="hidden" name="Samples[${index}].HasAttachment" value="false" />
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="inspection-panel-title mb-0">${escapeHtml(lotOption.dataset.itemName)} — اللوط ${escapeHtml(lotOption.dataset.lotNumber)} — ${totalWithdrawal ? 'سحب كلي' : 'سحب جزئي'}</div>
                        <button type="button" class="btn btn-sm btn-outline-danger remove-new-sample">حذف</button>
                    </div>
                    <div class="request-totals mb-3">
                        <div class="request-total"><span>الوزن القائم للوط</span><strong class="weight-control" data-weight-kg="${escapeHtml(lotOption.dataset.grossWeight)}">
        <bdi data-weight-value>${formatWeight(lotOption.dataset.grossWeight)}</bdi>

                                <select class="weight-unit" aria-label="وحدة الوزن"><option value="1">كيلوجرام</option><option value="1000">طن</option><option value="0.001">جرام</option></select></strong></div>
                        <div class="request-total"><span>عدد العبوات للوط</span><strong>${escapeHtml(lotOption.dataset.packageCount)}</strong></div>
                        <div class="request-total"><span>عدد الوحدات للوط</span><strong>${escapeHtml(lotOption.dataset.unitsCount)}</strong></div>
                        <div class="request-total"><span>عدد البالتات للوط</span><strong>${escapeHtml(lotOption.dataset.palletCount)}</strong></div>
                    </div>
                    <div class="lot-data-grid mb-3"><div><span>نوع التحليل</span><strong>${escapeHtml(analysisTypeSelect.selectedOptions[0].text)}</strong></div><div><span>معمل التحليل</span><strong>${escapeHtml(labOption.text)}</strong></div><div><span>رقم السحب</span><strong>يتولد عند الحفظ</strong></div></div>
                    <div class="inspection-fields">
                        <div class="inspection-field"><label class="form-label fw-bold">كمية العينة</label><input class="form-control" type="number" step="0.001" min="0.001" name="Samples[${index}].SampleSize" required /></div>
                        <input type="hidden" name="Samples[${index}].SampleRatio" value="0" />
                        <div class="inspection-field"><label class="form-label fw-bold">رقم الختم أو الرصاصة</label><input class="form-control" name="Samples[${index}].SealNumber" /></div>
                        <div class="inspection-field inspection-field-notes"><label class="form-label fw-bold">الملاحظات</label><textarea class="form-control" name="Samples[${index}].Notes" rows="2" required placeholder="اكتب ملاحظات السحب..."></textarea></div>
                    </div>`;
                card.querySelector('.remove-new-sample').addEventListener('click', () => card.remove());
card.querySelector('input[name$=".SampleSize"]').value=Number(sampleKg.toFixed(12)).toString();
card.querySelector('input[name$=".SealNumber"]').value=draftSeal.value.trim();
card.querySelector('textarea[name$=".Notes"]').value=draftNotes.value.trim();
card.querySelector('input[name$=".SampleSize"]') .dataset.quantityUnit=sampleUnit;
newSamplesContainer.appendChild(card);
bindInspectionSamples(card);
                }
draftSize.value='';draftSeal.value='';draftNotes.value='';
                document.getElementById('noSamplesMessage')?.remove();
                newSamplesContainer.querySelector('input[name$=".SampleSize"]')?.focus();
                analysisTypeSelect.value = '';
                analysisTypeSelect.dispatchEvent(new Event('change'));
            });
            samplesForm?.addEventListener('invalid', event => event.target.closest('details')?.setAttribute('open', 'open'), true);
            function reindexSamples() {
                [...samplesForm.querySelectorAll('input[name$=".SampleId"]')].forEach((sampleId, index) => {
                    const card = sampleId.closest('.inspection-panel');
                    card?.querySelectorAll('[name^="Samples["]').forEach(field =>
                        field.name = field.name.replace(/^Samples\[\d+\]/, `Samples[${index}]`));
                });
            }
            samplesForm?.addEventListener('submit', () => {
                reindexSamples();
                if (!samplesForm.checkValidity() || !samplesButton) return;
                samplesButton.disabled = true;
                samplesButton.textContent = 'جارٍ حفظ العينات وتوليد الباركود...';
            });
            const form = document.getElementById('inspectionSaveForm');
            const button = document.getElementById('saveInspectionButton');
            if (!form || !button) return;

            const modes = document.querySelectorAll('input[name="InspectionModeChoice"]');
            const applyToAll = document.getElementById('applyToAll');
            const completedLots = document.getElementById('completedLots');
            const totalLots = @allLots.Count;
            const infectionItems = @Html.Raw(infectionItemsJson);
            const currentMode = () => document.querySelector('input[name="InspectionModeChoice"]:checked')?.value ?? (applyToAll?.value === 'true' ? 'total' : 'partial');

            const initializeInfectionPanel = panel => {
                const group = panel.querySelector('.infection-group');
                const family = panel.querySelector('.infection-family');
                const item = panel.querySelector('.infection-item');
                const reset = (select, text) => { select.innerHTML = `<option value="">— ${text} —</option>`; select.disabled = true; };
                group.addEventListener('change', () => {
                    reset(family, 'اختر العائلة'); reset(item, 'اختر نوع الإصابة');
                    const families = [...new Map(infectionItems.filter(x => String(x.GroupId) === group.value).map(x => [x.FamilyId, x.FamilyName])).entries()];
                    families.forEach(([id, name]) => family.add(new Option(name, id)));
                    family.disabled = families.length === 0;
                });
                family.addEventListener('change', () => {
                    reset(item, 'اختر نوع الإصابة');
                    infectionItems.filter(x => String(x.GroupId) === group.value && String(x.FamilyId) === family.value)
                        .forEach(x => item.add(new Option(x.ScientificName ? `${x.ItemName} — ${x.ScientificName}` : x.ItemName, x.ItemId)));
                    item.disabled = item.options.length <= 1;
                });
            };
            document.querySelectorAll('[data-infection-panel]').forEach(initializeInfectionPanel);

            const updateInfectionPanels = () => {
                document.querySelectorAll('[data-infection-panel]').forEach(panel => {
                    panel.hidden = true;
                    panel.classList.remove('visible');
                    panel.querySelectorAll('select').forEach(field => { field.required = false; field.disabled = true; });
                });
            };

            const updateProgress = () => {
                if (!completedLots) return;
                if (currentMode() === 'total') {
                    const fields = [...document.querySelectorAll('.total-required')];
                    completedLots.textContent = fields.length && fields.every(x => x.value.trim() !== '') ? totalLots : 0;
                    return;
                }
                let completed = 0;
                document.querySelectorAll('.partial-inspection-panel').forEach(panel => {
                    const fields = [...panel.querySelectorAll('.partial-required')];
                    if (fields.length && fields.every(x => x.value.trim() !== '')) completed++;
                });
                completedLots.textContent = completed;
            };

            const setInspectionMode = () => {
                if (!applyToAll) return;
                const isTotal = currentMode() === 'total';
                applyToAll.value = isTotal ? 'true' : 'false';
                form.classList.toggle('total-mode', isTotal);
                if (isTotal) form.querySelectorAll('.lot-card').forEach(card => card.open = false);
                document.querySelectorAll('.total-inspection-panel').forEach(x => x.style.display = isTotal ? '' : 'none');
                document.querySelectorAll('.partial-inspection-panel').forEach(x => x.style.display = isTotal ? 'none' : '');
                document.querySelectorAll('.total-required').forEach(x => x.required = isTotal);
                document.querySelectorAll('.partial-required').forEach(x => x.required = !isTotal);
                updateInfectionPanels();
                updateProgress();
            };
            form.querySelectorAll('.lot-card > summary').forEach(summary => summary.addEventListener('click', event => {
                if (currentMode() === 'total' && !event.target.closest('.weight-unit')) event.preventDefault();
            }));
            modes.forEach(x => x.addEventListener('change', setInspectionMode));
            form.addEventListener('input', updateProgress);
            form.addEventListener('change', updateProgress);
            form.addEventListener('change', updateInfectionPanels);
            setInspectionMode();

            form.addEventListener('invalid', event => event.target.closest('details')?.setAttribute('open', 'open'), true);
            form.addEventListener('submit', event => {
                if (document.getElementById('performWithdrawal')?.value === 'true') {
                    if (!samplesForm?.querySelector('input[name$=".SampleId"]')) {
                        event.preventDefault();
                        alert('أضف تحليلًا وبيانات السحب قبل الحفظ.');
                        return;
                    }
                    reindexSamples();
                }
                if (!form.checkValidity()) {
                    event.preventDefault();
                    const invalidField = form.querySelector(':invalid');
                    invalidField?.closest('details')?.setAttribute('open', 'open');
                    return;
                }
                button.disabled = true;
                button.textContent = 'جارٍ الحفظ...';
            });
        })();
    </script>
}
