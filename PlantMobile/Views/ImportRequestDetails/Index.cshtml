                        }
                    </details>
                    sampleIndex++;
                }
            }
            @if (sampleIndex == 0) { <div class="alert alert-info text-center" id="noSamplesMessage">اختر اللوط ونوع التحليل ومعمل التحليل، ثم أضف بيانات السحب.</div> }
