@model ViewModels.PermissionOriginChangePageVm
@{
    ViewData["Title"] = "تعديل منشأ إذن الاستيراد";
}

<style>
    .origin-page{direction:rtl;max-width:1050px;margin:25px auto;padding:0 15px}.origin-head{margin-bottom:18px}.origin-head h2{margin:0;color:#246f73;font-weight:800}.origin-head p{color:#6f8388;margin:6px 0}.origin-card{background:#fff;border:1px solid #e0eaec;border-radius:15px;box-shadow:0 7px 24px rgba(27,61,68,.08);margin-bottom:16px;overflow:visible}.origin-title{padding:14px 18px;background:#eef8f8;color:#246f73;font-weight:800;border-radius:15px 15px 0 0}.origin-body{padding:18px}.search-form{display:flex;gap:10px;align-items:end}.search-form>div{flex:1}.search-form label{font-weight:700;margin-bottom:7px}.search-form .form-control{height:43px;border-radius:8px}.item-card{border:1px solid #e2eaec;border-radius:12px;padding:15px;margin-bottom:13px}.item-head{display:flex;justify-content:space-between;gap:15px;margin-bottom:12px}.item-name{font-weight:800;color:#2a454a}.item-scientific{color:#77878b;font-size:13px}.current-origin{background:#f3f8f8;border-radius:8px;padding:7px 11px;color:#44676b;white-space:nowrap}.origin-picker{position:relative}.origin-picker-button{width:100%;height:43px;border:1px solid #ced4da;border-radius:8px;background:#fff;text-align:right;padding:7px 12px;display:flex;justify-content:space-between;align-items:center}.origin-picker-button:after{content:'▾'}.origin-picker-panel{display:none;position:absolute;z-index:1100;top:calc(100% + 4px);right:0;left:0;background:#fff;border:1px solid #cedadd;border-radius:10px;box-shadow:0 10px 28px rgba(23,57,63,.18);padding:9px}.origin-picker.open .origin-picker-panel{display:block}.origin-picker-search{height:38px!important;margin-bottom:7px}.origin-options{max-height:230px;overflow:auto}.origin-option{display:block;width:100%;border:0;background:#fff;text-align:right;padding:8px 10px;border-radius:6px}.origin-option:hover,.origin-option.selected{background:#eaf7f7;color:#1e696d}.origin-empty{text-align:center;color:#77878b;padding:16px}.origin-actions{display:flex;justify-content:center;gap:10px;margin-top:18px}.origin-actions .btn{min-width:155px;border-radius:8px}.origin-summary{background:#f7fafa;border:1px solid #e4eded;border-radius:10px;padding:12px 15px;margin-bottom:15px}@@media(max-width:650px){.search-form,.item-head,.origin-actions{flex-direction:column}.search-form .btn,.origin-actions .btn{width:100%}.current-origin{white-space:normal;width:100%}}
</style>

<div class="origin-page">
    <header class="origin-head"><h2>تعديل منشأ إذن الاستيراد</h2><p>اختر المنشأ الجديد لكل بند من المناشئ المعتمدة لنفس الصنف</p></header>

    @if (TempData["OriginError"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

    @if (Model.PermissionRequestId == 0)
    {
        <section class="origin-card">
            <div class="origin-title">البحث عن إذن الاستيراد</div>
            <div class="origin-body">
                <form asp-action="Index" method="get" class="search-form">
                    <div><label for="permissionNumber">رقم إذن الاستيراد</label><input id="permissionNumber" name="ImPermission_Number" class="form-control" value="@Model.PermissionNumber" required autocomplete="off" /></div>
                    <button type="submit" class="btn btn-primary">عرض البنود</button>
                </form>
            </div>
        </section>
    }
    else
    {
        <section class="origin-card">
            <div class="origin-title">بيانات الإذن</div>
            <div class="origin-body">
                <div class="origin-summary">رقم إذن الاستيراد: <strong>@Model.PermissionNumber</strong> — عدد البنود: <strong>@Model.Items.Count</strong></div>
                <form asp-action="Save" method="post" id="originForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PermissionRequestId" value="@Model.PermissionRequestId" />
                    <input type="hidden" name="PermissionNumber" value="@Model.PermissionNumber" />
                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                    @for (var i = 0; i < Model.Items.Count; i++)
                    {
                        var item = Model.Items[i];
                        <div class="item-card">
                            <input type="hidden" name="Items[@i].PermissionItemId" value="@item.PermissionItemId" />
                            <input type="hidden" class="origin-id" name="Items[@i].InitiatorId" value="@item.SelectedInitiatorId" required />
                            <div class="item-head">
                                <div><div class="item-name">@item.ItemName</div>@if (!string.IsNullOrWhiteSpace(item.ScientificName)){<div class="item-scientific">@item.ScientificName</div>}</div>
                                <div class="current-origin">المنشأ الحالي: <strong>@item.CurrentCountry</strong></div>
                            </div>
                            @if (item.Origins.Count == 0)
                            {
                                <div class="origin-empty">لا توجد مناشئ متاحة لهذا الصنف.</div>
                            }
                            else
                            {
                                var selectedText = item.Origins.FirstOrDefault(x => x.InitiatorId == item.SelectedInitiatorId)?.CountryName ?? "اختر المنشأ";
                                <label>المنشأ الجديد</label>
                                <div class="origin-picker">
                                    <button type="button" class="origin-picker-button">@selectedText</button>
                                    <div class="origin-picker-panel">
                                        <input type="search" class="form-control origin-picker-search" placeholder="ابحث داخل الدول..." autocomplete="off" />
                                        <div class="origin-options">
                                            @foreach (var origin in item.Origins)
                                            {
                                                <button type="button" class="origin-option @(origin.InitiatorId == item.SelectedInitiatorId ? "selected" : "")" data-id="@origin.InitiatorId" data-text="@origin.CountryName">@origin.CountryName</button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <div class="origin-actions"><button type="submit" class="btn btn-primary">حفظ تغيير المنشأ</button><a href="@Model.ReturnUrl" class="btn btn-outline-secondary">رجوع بدون حفظ</a></div>
                </form>
            </div>
        </section>
    }
</div>

@section Scripts {
<script>
$(function(){
 $('.origin-picker-button').on('click',function(){var picker=$(this).closest('.origin-picker');$('.origin-picker').not(picker).removeClass('open');picker.toggleClass('open');if(picker.hasClass('open'))picker.find('.origin-picker-search').val('').trigger('input').trigger('focus');});
 $('.origin-picker-search').on('input',function(){var q=$(this).val().trim().toLowerCase();$(this).siblings('.origin-options').find('.origin-option').each(function(){$(this).toggle(!q||$(this).text().toLowerCase().indexOf(q)>=0);});});
 $('.origin-option').on('click',function(){var option=$(this),picker=option.closest('.origin-picker'),card=picker.closest('.item-card');card.find('.origin-id').val(option.data('id'));picker.find('.origin-picker-button').text(option.data('text'));picker.find('.origin-option').removeClass('selected');option.addClass('selected');picker.removeClass('open');});
 $(document).on('click',function(e){if(!$(e.target).closest('.origin-picker').length)$('.origin-picker').removeClass('open');});
 $('#originForm').on('submit',function(e){var valid=true;$(this).find('.origin-id').each(function(){if(!$(this).val())valid=false;});if(!valid){e.preventDefault();alert('يجب اختيار منشأ صالح لكل بند.');}});
});
</script>
}
