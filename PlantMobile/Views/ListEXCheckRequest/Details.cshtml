                    <h4 class="committee-info-title">اختيار اللوطات وبدلات المهندسين</h4>
                    <div id="committeeWorkOptions">
                        <div class="sample-option-card">
                            <h5 class="employee-table-title">اختيار اللوطات</h5>
                            <div class="table-responsive"><table class="table table-bordered table-striped sample-table"><thead><tr><th>الصنف</th><th>رقم اللوط</th><th>الوزن</th><th>اختيار</th></tr></thead><tbody>@foreach(var item in Model.Items){foreach(var lot in item.Lots){<tr><td>@Text(item.ShortName)</td><td>@Text(lot.LotNumber)</td><td>@(lot.GrossWeight?.ToString("N3")??"—")</td><td><input type="checkbox" class="sample-lot-check" name="selectedLotIds" value="@lot.Id" /></td></tr>}}</tbody></table></div>
                        </div>
                        <div class="sample-option-card" id="sampleLabsCard" style="display:none" aria-hidden="true">
