@model ViewModels.ExportInspectionRequestDetailsVm
@{ViewData["Title"]="تفاصيل طلب الفحص";}
<style>
    .details-page{direction:rtl;max-width:1400px;margin:28px auto;padding:0;color:#263b42;background:#f3f6f9;border-radius:10px;overflow:hidden;box-shadow:0 10px 32px rgba(22,46,67,.10)}.details-head{display:flex;justify-content:space-between;align-items:flex-start;gap:15px;margin:0;padding:18px 24px;background:linear-gradient(135deg,#1a365d,#2c5282);color:#fff}.details-head h2{margin:0;color:#fff;font-weight:800}.details-head p{margin:7px 0 0;color:#e7eef7}.back-link{border:1px solid rgba(255,255,255,.55);border-radius:7px;padding:9px 16px;color:#fff;text-decoration:none;background:rgba(255,255,255,.1)}
    .details-body{padding:24px}.summary{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}.summary-box{background:#fff;border:1px solid #e0e7ed;border-radius:9px;padding:17px;box-shadow:0 3px 12px rgba(30,58,78,.05)}.summary-box span{display:block;color:#74868c;font-size:13px;margin-bottom:7px}.summary-box strong{font-size:17px}.state{color:#2c5282}
    .section-card{background:#fff;border:1px solid #e0e7ed;border-radius:9px;margin-bottom:20px;box-shadow:0 3px 12px rgba(30,58,78,.05);overflow:hidden}.section-title{margin:18px 20px 0;padding:9px 14px;background:#dfeccd;color:#34412b;font-size:18px;font-weight:800;border-radius:7px}.info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;padding:8px 20px 20px}.info{padding:14px;border-bottom:1px dashed #e1e8ea}.info span{display:block;color:#263b53;font-size:13px;font-weight:700;margin-bottom:6px}.info strong{font-weight:600}.full{grid-column:1/-1}
    .item-card{margin:16px 20px;border:1px solid #dde8ea;border-radius:12px;overflow:hidden}.item-head{display:flex;justify-content:space-between;align-items:center;background:#f7fafb;padding:13px 16px}.item-head h4{margin:0;font-size:16px}.item-stats{display:flex;gap:18px;padding:13px 16px;flex-wrap:wrap}.item-stats span{color:#71848b}.item-stats strong{color:#263b42}.lots{padding:0 16px 16px}.lots h5{font-size:14px;color:#176c70}.lots table{margin:0}.lots th,.lots td{text-align:center;font-size:13px;vertical-align:middle}.empty-section{padding:28px;text-align:center;color:#7b8b91}.accept{color:#1d7547}.reject{color:#ac3f48}
    .committee-form{padding:18px 20px}.committee-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.committee-form label{display:block;font-weight:700;color:#263b53;margin-bottom:7px}.committee-form .form-control{height:41px}.engineers{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:15px 0}.engineer{border:1px solid #dce6e9;border-radius:8px;padding:10px;background:#fafcfc}.engineer input{margin-left:7px}.all-lots{background:#f2f8eb;border:1px solid #d8e9c7;border-radius:8px;padding:12px;margin:14px 0}.all-lots span{display:inline-block;margin:4px 8px;padding:5px 9px;background:#fff;border-radius:6px}.committee-submit{text-align:center}.committee-submit .btn{min-width:180px;background:#6ab529;border-color:#5da124}.committee-list{padding:0 20px 20px}
    @@media(max-width:850px){.summary{grid-template-columns:repeat(2,1fr)}.info-grid{grid-template-columns:repeat(2,1fr)}.committee-grid,.engineers{grid-template-columns:repeat(2,1fr)}}@@media(max-width:550px){.details-page{margin:12px 8px}.details-body{padding:12px}.details-head{flex-direction:column}.summary,.info-grid,.committee-grid,.engineers{grid-template-columns:1fr}.full{grid-column:auto}.item-head{align-items:flex-start;flex-direction:column;gap:7px}.summary-box{padding:14px}}
</style>
<div class="details-page">
    <div class="details-head"><div><h2>تفاصيل طلب الفحص</h2><p>رقم الطلب: <strong>@Model.RequestNumber</strong></p></div><a asp-action="Index" class="back-link">العودة للقائمة</a></div>
    <div class="details-body">
    @if(TempData["CommitteeSuccess"] is string committeeSuccess){<div class="alert alert-success">@committeeSuccess</div>}@if(TempData["CommitteeError"] is string committeeError){<div class="alert alert-danger">@committeeError</div>}
    <div class="summary"><div class="summary-box"><span>تاريخ الطلب</span><strong>@(Model.CreationDate?.ToString("dd/MM/yyyy hh:mm tt")??"—")</strong></div><div class="summary-box"><span>حالة الطلب</span><strong class="state">@RequestState()</strong></div><div class="summary-box"><span>النتيجة النهائية</span><strong>@Text(Model.FinalResult)</strong></div><div class="summary-box"><span>إجمالي الرسوم</span><strong>@(Model.Fees.Sum(x=>x.TotalAmount)?.ToString("N2")??Model.Amount?.ToString("N2")??"—")</strong></div></div>
    <section class="section-card"><h3 class="section-title">بيانات الجهة المصدرة</h3><div class="info-grid"><div class="info"><span>نوع الجهة المصدرة</span><strong>@Text(Model.ImporterType)</strong></div><div class="info"><span>الشركة / الجهة المصدرة</span><strong>@Text(Model.ImporterName)</strong></div><div class="info"><span>صاحب الشركة / الشخص المسئول</span><strong>@Text(Model.OwnerName)</strong></div><div class="info"><span>عنوان الجهة</span><strong>@Text(Model.OwnerAddress)</strong></div><div class="info"><span>مندوب صاحب الرسالة</span><strong>@Text(Model.DelegateName)</strong></div><div class="info"><span>الرقم القومي للمندوب</span><strong>@Text(Model.DelegateAddress)</strong></div></div></section>
    <section class="section-card"><h3 class="section-title">مسار الرسالة</h3><div class="info-grid"><div class="info"><span>ميناء الشحن</span><strong>@Text(Model.ShippingPort)</strong></div><div class="info"><span>الدولة المستوردة</span><strong>@Text(Model.Country)</strong></div><div class="info"><span>نوع ميناء الوصول</span><strong>@Text(Model.ArrivalPortType)</strong></div><div class="info"><span>ميناء الوصول</span><strong>@Text(Model.ArrivalPort)</strong></div><div class="info"><span>دولة العبور</span><strong>@Text(Model.TransitCountry)</strong></div><div class="info"><span>نوع ميناء العبور</span><strong>@Text(Model.TransitPortType)</strong></div><div class="info"><span>ميناء العبور</span><strong>@Text(Model.TransitPort)</strong></div><div class="info"><span>اسم الباخرة</span><strong>@Text(Model.ShipName)</strong></div><div class="info"><span>وسيلة الشحن / النقل</span><strong>@Text(string.Join(" - ",new[]{Model.ShipmentMean,Model.TransportMean}.Where(x=>!string.IsNullOrWhiteSpace(x))))</strong></div><div class="info"><span>اسم الشركة المستوردة</span><strong>@Text(Model.ImportCompany)</strong></div><div class="info"><span>اسم المرسل إليه</span><strong>@Text(Model.ReceiverName)</strong></div><div class="info"><span>عنوان المرسل إليه</span><strong>@Text(Model.ImportCompanyAddress)</strong></div></div></section>
    <section class="section-card"><h3 class="section-title">مكان الفحص ولجنة الفحص</h3><div class="info-grid"><div class="info"><span>منفذ / محطة الفحص</span><strong>@Text(Model.ExaminationPlace)</strong></div><div class="info"><span>المحافظة</span><strong>@Text(Model.ExaminationGovernorate)</strong></div><div class="info"><span>المركز</span><strong>@Text(Model.ExaminationCenter)</strong></div><div class="info"><span>عنوان مكان الفحص</span><strong>@Text(Model.ExaminationAddress)</strong></div><div class="info"><span>منفذ / محطة لجنة الفحص</span><strong>@Text(Model.GenshiPlace)</strong></div><div class="info"><span>تاريخ النتيجة</span><strong>@(Model.FinalResultDate?.ToString("dd/MM/yyyy")??"—")</strong></div></div></section>
    <section class="section-card"><h3 class="section-title">تشكيل لجان الصادر</h3>@if(!Model.ExaminationStationId.HasValue){<div class="empty-section">هذا الطلب غير مسجل على محطة فحص؛ تشكيل مهندسي المحطة متاح للطلبات المسجلة على محطة فقط.</div>}else if(Model.StationEngineers.Count==0){<div class="empty-section">لا يوجد مهندسون مسكنون على محطة @Text(Model.ExaminationStationName) في الفترة الحالية.</div>}else{<form asp-action="CreateCommittee" asp-route-id="@Model.Id" method="post" class="committee-form" id="committeeForm">@Html.AntiForgeryToken()<div class="committee-grid"><div><label for="committeeTypeId">نوع اللجنة</label><select id="committeeTypeId" name="committeeTypeId" class="form-control" required><option value="1">لجنة فحص</option><option value="3">لجنة سحب عينات</option><option value="6">لجنة معالجة</option></select></div><div><label for="delegationDate">تاريخ اللجنة</label><input id="delegationDate" name="delegationDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required /></div><div><label for="startTime">من الساعة</label><input id="startTime" name="startTime" type="time" value="09:00" class="form-control" required /></div><div><label for="endTime">إلى الساعة</label><input id="endTime" name="endTime" type="time" value="14:00" class="form-control" required /></div></div><h4>مهندسو محطة @Text(Model.ExaminationStationName)</h4><div class="engineers">@foreach(var engineer in Model.StationEngineers){<label class="engineer"><input type="checkbox" name="employeeIds" value="@engineer.UserId" /><strong>@engineer.Name</strong>@if(engineer.EmployeeId.HasValue){<small> — @engineer.EmployeeId</small>}</label>}</div><div><label for="adminEmployeeId">رئيس اللجنة</label><select id="adminEmployeeId" name="adminEmployeeId" class="form-control" required><option value="">اختر رئيس اللجنة من المهندسين</option>@foreach(var engineer in Model.StationEngineers){<option value="@engineer.UserId">@engineer.Name</option>}</select></div><div class="all-lots"><strong>نطاق اللجنة: كلي</strong><p>سيتم اختيار كل لوطات الطلب تلقائيًا:</p>@foreach(var item in Model.Items){foreach(var lot in item.Lots){<span><i class="fa fa-check"></i> @Text(item.ShortName) — لوط @Text(lot.LotNumber)</span>}}</div><div class="committee-submit"><button type="submit" class="btn btn-success">حفظ وتشكيل اللجنة</button></div></form>}@if(Model.Committees.Count>0){<div class="committee-list"><h4>اللجان المشكلة على الطلب</h4><div class="table-responsive"><table class="table table-striped"><thead><tr><th>رقم اللجنة</th><th>النوع</th><th>التاريخ</th><th>المهندسون</th><th>السجلات الكلية</th></tr></thead><tbody>@foreach(var committee in Model.Committees){<tr><td>@committee.Id</td><td>@committee.CommitteeType</td><td>@(committee.DelegationDate?.ToString("dd/MM/yyyy")??"—")</td><td>@Text(committee.Employees)</td><td>@committee.LotCount</td></tr>}</tbody></table></div></div>}</section>
    <section class="section-card"><h3 class="section-title">بيانات الرسالة</h3>@if(Model.Items.Count==0){<div class="empty-section">لا توجد أصناف مسجلة على الطلب</div>}@foreach(var item in Model.Items){<article class="item-card"><div class="item-head"><h4>@Text(item.ShortName)</h4><strong class="@(item.IsAccepted?"accept":"reject")">@(item.IsAccepted?"مقبول":"غير مقبول")</strong></div><div class="item-stats"><span>اسم المنتج: <strong>@Text(item.Category)</strong></span><span>المجموعة: <strong>@Text(item.CategoryGroup)</strong></span><span>كود المزرعة: <strong>@Text(item.FarmCode)</strong></span><span>اسم المزرعة: <strong>@Text(item.FarmName)</strong></span></div>@if(item.Lots.Count>0){<div class="lots"><div class="table-responsive"><table class="table table-striped"><thead><tr><th>رقم اللوط</th><th>العدد ونوع العبوة</th><th>مادة العبوة</th><th>وزن العبوة القائم</th><th>وزن العبوة الصافي</th><th>الوزن الإجمالي</th><th>الوزن الصافي</th><th>رقم المزرعة</th><th>النتيجة</th></tr></thead><tbody>@foreach(var lot in item.Lots){<tr><td>@Text(lot.LotNumber)</td><td>@(lot.PackageCount?.ToString()??"—") @Text(lot.PackageType)</td><td>@Text(lot.PackageMaterial)</td><td>@(lot.PackageGrossWeight?.ToString("N3")??"—")</td><td>@(lot.PackageNetWeight?.ToString("N3")??"—")</td><td>@(lot.GrossWeight?.ToString("N3")??"—")</td><td>@(lot.NetWeight?.ToString("N3")??"—")</td><td>@Text(lot.GrowerNumber)</td><td class="@(lot.IsAccepted==false?"reject":"accept")">@(lot.IsAccepted==true?"مقبول":lot.IsAccepted==false?"مرفوض":"لم تحدد")</td></tr>}</tbody></table></div></div>}</article>}</section>
    <section class="section-card"><h3 class="section-title">المرفقات</h3>@if(Model.Attachments.Count==0){<div class="empty-section">لا توجد مرفقات على الطلب</div>}else{<div class="table-responsive lots"><table class="table table-striped"><thead><tr><th>م</th><th>نوع المرفق</th><th>رقم المرفق</th><th>تاريخ البداية</th><th>تاريخ النهاية</th><th>الملف</th></tr></thead><tbody>@for(int i=0;i<Model.Attachments.Count;i++){var attachment=Model.Attachments[i];<tr><td>@(i+1)</td><td>@Text(attachment.Name)</td><td>@Text(attachment.Number)</td><td>@(attachment.StartDate?.ToString("dd/MM/yyyy")??"—")</td><td>@(attachment.EndDate?.ToString("dd/MM/yyyy")??"—")</td><td>@if(!string.IsNullOrWhiteSpace(attachment.Path)){<a href="@attachment.Path" target="_blank" rel="noopener">عرض المرفق</a>}else{<span>—</span>}</td></tr>}</tbody></table></div>}</section>
    <section class="section-card"><h3 class="section-title">الرسوم</h3>@if(Model.Fees.Count==0){<div class="empty-section">لا توجد رسوم مسجلة</div>}else{<div class="table-responsive lots"><table class="table table-striped"><thead><tr><th>إجمالي الوزن القائم</th><th>قيمة الرسم</th><th>إجمالي الرسوم</th><th>تقريب الرسوم</th></tr></thead><tbody>@foreach(var fee in Model.Fees){<tr><td>@(fee.TotalGrossWeight?.ToString("N3")??"—")</td><td>@(fee.FeeValue?.ToString("N2")??"—")</td><td>@(fee.TotalAmount?.ToString("N2")??"—")</td><td>@(fee.IsRounded==true?"نعم":"لا")</td></tr>}</tbody></table></div>}</section>
    @if(!string.IsNullOrWhiteSpace(Model.RejectNotes)){<section class="section-card"><h3 class="section-title">ملاحظات الرفض</h3><div class="info-grid"><div class="info full"><strong class="reject">@Model.RejectNotes</strong></div></div></section>}
    </div>
</div>
@functions{string Text(string? value)=>string.IsNullOrWhiteSpace(value)?"—":value;string RequestState()=>Model.ClosedRequest==1?"مغلق":!string.IsNullOrWhiteSpace(Model.FinalResult)?"ظهرت النتيجة":Model.IsAccepted==false?"مرفوض":"جاري الفحص";}
@section Scripts{<script>$(function(){$('#adminEmployeeId').on('change',function(){var value=this.value;if(value)$('input[name="employeeIds"][value="'+value+'"]').prop('checked',true);});$('#committeeForm').on('submit',function(e){if(!$('input[name="employeeIds"]:checked').length){e.preventDefault();alert('اختر مهندسًا واحدًا على الأقل.');return;}if($('#startTime').val()>=$('#endTime').val()){e.preventDefault();alert('وقت البداية يجب أن يسبق وقت النهاية.');}});});</script>}
