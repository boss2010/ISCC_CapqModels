                            <input id="labSearch" type="search" class="form-control" placeholder="ابحث باسم التحليل أو المعمل" autocomplete="off" />
                            <div class="table-responsive lab-table-wrap"><table class="table table-bordered table-striped sample-table" id="analysisLabsTable"><thead><tr><th>التحليل</th><th>المعمل</th><th>اختيار</th></tr></thead><tbody>@foreach(var lab in Model.AnalysisLabs){<tr><td>@lab.AnalysisName</td><td>@lab.LabName</td><td><input type="checkbox" class="sample-lab-check" name="selectedAnalysisLabTypeIds" value="@lab.Id" /></td></tr>}</tbody></table></div>
                        </div>
                        <div class="sample-option-card">
