@model ViewModels.ExportInspectionRequestDetailsVm
@{ViewData["Title"]="تفاصيل طلب الفحص";}
<style>
    .details-page{direction:rtl;max-width:1400px;margin:28px auto;padding:0;color:#263b42;background:#f3f6f9;border-radius:10px;overflow:hidden;box-shadow:0 10px 32px rgba(22,46,67,.10)}.details-head{display:flex;justify-content:space-between;align-items:flex-start;gap:15px;margin:0;padding:18px 24px;background:linear-gradient(135deg,#1a365d,#2c5282);color:#fff}.details-head h2{margin:0;color:#fff;font-weight:800}.details-head p{margin:7px 0 0;color:#e7eef7}.back-link{border:1px solid rgba(255,255,255,.55);border-radius:7px;padding:9px 16px;color:#fff;text-decoration:none;background:rgba(255,255,255,.1)}
    .details-body{padding:24px}.summary{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}.summary-box{background:#fff;border:1px solid #e0e7ed;border-radius:9px;padding:17px;box-shadow:0 3px 12px rgba(30,58,78,.05)}.summary-box span{display:block;color:#74868c;font-size:13px;margin-bottom:7px}.summary-box strong{font-size:17px}.state{color:#2c5282}
    .section-card{background:#fff;border:1px solid #e0e7ed;border-radius:9px;margin-bottom:20px;box-shadow:0 3px 12px rgba(30,58,78,.05);overflow:hidden}.section-title{margin:18px 20px 0;padding:9px 14px;background:#dfeccd;color:#34412b;font-size:18px;font-weight:800;border-radius:7px}.info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;padding:8px 20px 20px}.info{padding:14px;border-bottom:1px dashed #e1e8ea}.info span{display:block;color:#263b53;font-size:13px;font-weight:700;margin-bottom:6px}.info strong{font-weight:600}.full{grid-column:1/-1}
    .item-card{margin:16px 20px;border:1px solid #dde8ea;border-radius:12px;overflow:hidden}.item-head{display:flex;justify-content:space-between;align-items:center;background:#f7fafb;padding:13px 16px}.item-head h4{margin:0;font-size:16px}.item-stats{display:flex;gap:18px;padding:13px 16px;flex-wrap:wrap}.item-stats span{color:#71848b}.item-stats strong{color:#263b42}.lots{padding:0 16px 16px}.lots h5{font-size:14px;color:#176c70}.lots table{margin:0}.lots th,.lots td{text-align:center;font-size:13px;vertical-align:middle}.empty-section{padding:28px;text-align:center;color:#7b8b91}.accept{color:#1d7547}.reject{color:#ac3f48}
    .committee-form{padding:18px 20px}.committee-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.committee-form label{display:block;font-weight:700;color:#263b53;margin-bottom:7px}.committee-form .form-control{height:41px}.committee-panel{border:1px solid #dce6e9;border-radius:10px;padding:16px;margin:16px 0;background:#fbfcfd}.committee-panel-title{font-size:16px;font-weight:800;color:#1a365d;margin:0 0 12px;border-right:4px solid #e5ad4f;padding-right:9px}.employee-search{position:relative;margin-bottom:12px;max-width:520px}.employee-search input{padding-right:38px}.employee-search i{position:absolute;right:13px;top:13px;color:#7c8d94}.employee-count{color:#63777f;font-size:13px;margin:8px 0}.engineers{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:10px 0}.engineer{border:1px solid #dce6e9;border-radius:8px;padding:11px;background:#fff;cursor:pointer;transition:.15s}.engineer:hover{border-color:#6ab529;background:#f7fbf2}.engineer.is-selected{border-color:#5da124;background:#f0f8e8;box-shadow:0 0 0 1px #79bd40 inset}.engineer input{margin-left:7px}.engineer small{display:block;margin:5px 24px 0 0;color:#74868c}.all-lots{background:#f2f8eb;border:1px solid #d8e9c7;border-radius:8px;padding:12px;margin:14px 0}.all-lots span{display:inline-block;margin:4px 8px;padding:5px 9px;background:#fff;border-radius:6px}.committee-submit{text-align:center}.committee-submit .btn{min-width:210px;background:#6ab529;border-color:#5da124;padding:10px 20px;font-weight:800}.committee-list{padding:0 20px 20px}
    .section-card.accordion-card>.section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;cursor:pointer;user-select:none;transition:background .2s;margin-bottom:18px}.section-card.accordion-card>.section-title:hover,.section-card.accordion-card>.section-title:focus{background:#d2e5b8;outline:2px solid transparent}.accordion-arrow{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:#fff;color:#52752f;font-size:14px;transition:transform .2s}.accordion-card.is-open .accordion-arrow{transform:rotate(180deg)}.accordion-content[hidden]{display:none!important}.accordion-content{animation:accordionOpen .18s ease-out}@@keyframes accordionOpen{from{opacity:.25;transform:translateY(-4px)}to{opacity:1;transform:none}}
    @@media(max-width:850px){.summary{grid-template-columns:repeat(2,1fr)}.info-grid{grid-template-columns:repeat(2,1fr)}.committee-grid,.engineers{grid-template-columns:repeat(2,1fr)}}@@media(max-width:550px){.details-page{margin:12px 8px}.details-body{padding:12px}.details-head{flex-direction:column}.summary,.info-grid,.committee-grid,.engineers{grid-template-columns:1fr}.full{grid-column:auto}.item-head{align-items:flex-start;flex-direction:column;gap:7px}.summary-box{padding:14px}}
</style>
<style>
    .committee-form{padding:22px;background:#f5f8f8}.committee-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 22px}.committee-form label{color:#34495e;margin-bottom:8px}.committee-form .form-control{height:42px;border:1px solid #cfdddd;border-radius:7px;box-shadow:none}.committee-form .form-control:focus{border-color:#1e7c80;box-shadow:0 0 0 3px rgba(30,124,128,.12)}.committee-form .form-control[readonly]{background:#f4f8f8;color:#4d6263}.committee-panel{border:1px solid #e2ecec;border-radius:12px;padding:24px;background:#fff;box-shadow:0 5px 16px rgba(30,124,128,.08)}.committee-panel-title{font-size:18px;color:#167479;margin:0 0 20px;padding:0 0 12px;border:0;border-bottom:2px solid #e4f0f0}.fallback-outlet-field{padding:16px;margin-bottom:18px;background:#fff8e8;border:1px solid #eed49b;border-radius:8px}.fallback-outlet-field small{display:block;margin-top:7px;color:#785d24}.committee-submit{text-align:left;padding-top:18px;border-top:1px solid #e6eeee}.committee-submit .btn{background:#1e7c80;border-color:#176b6f;border-radius:7px}.committee-list{padding:20px;background:#fff}.committee-list h4{color:#167479;font-weight:800}.committee-list table thead{background:#252632;color:#fff}
    .committee-page-header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 25px;color:#fff;background:linear-gradient(135deg,#176f74,#245962)}.committee-page-header h3{margin:0 0 6px;color:#fff;font-size:22px;font-weight:800}.committee-page-header p{margin:0;color:#d9eeee}.committee-outlet{min-width:250px;padding:12px 16px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.25);border-radius:9px}.committee-outlet span{display:block;font-size:12px;color:#cfe5e5}.committee-outlet strong{display:block;margin-top:4px}.import-committee-form{padding:24px;background:#f4f7f7}.committee-info-card,.employee-card,.message-card{padding:24px;margin-bottom:20px;background:#fff;border:1px solid #e2ecec;border-radius:12px;box-shadow:0 5px 16px rgba(30,124,128,.08)}.committee-info-title{margin:0 0 20px;padding-bottom:12px;color:#167479;font-size:18px;font-weight:800;border-bottom:2px solid #e4f0f0}.committee-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 22px}.committee-field label,.employee-search-grid label{display:block;margin-bottom:7px;color:#34495e;font-weight:700}.committee-field .form-control,.employee-search-grid .form-control{height:42px;border:1px solid #cfdddd;border-radius:7px;box-shadow:none}.employee-help{color:#607779}.employee-search-grid{display:grid;grid-template-columns:1fr 1fr auto;align-items:end;gap:16px;margin:18px 0 20px}.employee-search-button{min-width:145px;height:42px;color:#fff;background:#1e7c80;border-color:#176b6f}.employee-table-title{margin:20px 0 10px;color:#167479;font-size:16px;font-weight:800}.employee-empty-message{display:none;padding:14px;margin:10px 0;text-align:center;color:#536b6d;background:#f4f8f8;border-radius:7px}.employee-card table th,.employee-card table td{text-align:center;vertical-align:middle}.employee-card table thead{color:#fff;background:#252632}.employee-select-check{width:18px;height:18px;cursor:pointer}.admin-radio{width:18px;height:18px}.remove-employee{padding:5px 12px;color:#a94442;background:#fbe9e8;border:1px solid #efc3c0;border-radius:6px}.committee-submit{padding:18px 24px;text-align:left;background:#fff}.committee-submit .btn{min-width:200px;padding:11px 26px}.fallback-outlet-field{max-width:620px}.committee-list table th,.committee-list table td{text-align:center;vertical-align:middle}
    @@media(max-width:767px){.committee-page-header{align-items:stretch;flex-direction:column}.committee-outlet{min-width:0}.committee-fields,.employee-search-grid{grid-template-columns:1fr}.employee-search-button{width:100%}}
</style>
<style>
    .committee-steps{display:flex;gap:0;padding:0;margin:0 0 22px;list-style:none;border-bottom:2px solid #dce9e9}.committee-steps li{flex:1;padding:13px 16px;text-align:center;color:#657a7c;background:#edf3f3;border-left:1px solid #dce9e9;font-weight:800;transition:.2s}.committee-steps li.active{color:#fff;background:#1e7c80}.committee-steps li.done{color:#176f74;background:#dff0ed}.committee-step-pane[hidden]{display:none!important}.committee-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:24px;padding-top:18px;border-top:1px solid #e6eeee}.committee-actions.between{justify-content:space-between}.committee-actions .btn{min-width:150px;padding:9px 24px}.committee-prev{color:#40595b;background:#eef3f3;border-color:#d4e1e1}
    @@media(max-width:600px){.committee-steps{flex-direction:column}.committee-steps li{border-bottom:1px solid #dce9e9}}
    .sample-option-card{padding:18px;margin:15px 0;background:#fff;border:1px solid #dfeaea;border-radius:9px}.sample-table th,.sample-table td{text-align:center;vertical-align:middle}.sample-table thead{color:#fff;background:#252632}.sample-lot-check,.sample-lab-check{width:18px;height:18px}.lab-table-wrap{max-height:330px;overflow:auto;margin-top:12px}.shift-entry-grid{display:grid;grid-template-columns:2fr 1fr 1fr auto;align-items:end;gap:14px;margin-bottom:16px}.shift-entry-grid #addShift{height:42px;min-width:110px}.shift-empty{text-align:center;color:#718184}.remove-shift{padding:5px 12px;color:#a94442;background:#fbe9e8;border:1px solid #efc3c0;border-radius:6px}
    @@media(max-width:767px){.shift-entry-grid{grid-template-columns:1fr}}
    .employee-pagination{display:flex;align-items:center;justify-content:center;gap:14px;margin:12px 0 20px}.employee-pagination .btn{min-width:90px;color:#176f74;background:#eef5f5;border:1px solid #cddede}.employee-pagination .btn:disabled{opacity:.45}.employee-pagination .page-info{color:#536b6d;font-weight:700}
    .decision-card{padding:20px;margin-bottom:20px;background:#fff;border:1px solid #dce6e9;border-radius:10px}.decision-card h3{margin:0 0 12px;color:#1a365d;font-size:19px}.decision-card textarea{min-height:90px;resize:vertical}.decision-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:13px}.decision-actions .btn{min-width:150px;font-weight:800}.btn-completion{color:#fff;background:#d59b33;border-color:#bd8421}.current-decision{display:inline-block;margin-bottom:12px;padding:6px 12px;border-radius:20px;color:#31545a;background:#eaf3f3;font-weight:700}
</style>
<div class="details-page">
    <div class="details-head"><div><h2>@(Model.IsSupervisorReadOnly?"متابعة طلب صادر — عرض فقط":"تفاصيل طلب الفحص")</h2><p>رقم الطلب: <strong>@Model.RequestNumber</strong></p></div><a asp-action="@(Model.IsSupervisorReadOnly?"Supervisor":"Index")" class="back-link">العودة للقائمة</a></div>
    <div class="details-body">
    @if(Model.IsSupervisorReadOnly){<style>.committee-form{display:none!important}</style><div class="alert alert-info">صلاحية المشرف العام للعرض فقط. يمكنك مشاهدة أماكن الطلب واللجان والموظفين الذين عملوا عليه دون تعديل.</div>}@if(TempData["CommitteeSuccess"] is string committeeSuccess){<div class="alert alert-success">@committeeSuccess</div>}@if(TempData["CommitteeError"] is string committeeError){<div class="alert alert-danger">@committeeError</div>}@if(TempData["DecisionSuccess"] is string decisionSuccess){<div class="alert alert-success">@decisionSuccess</div>}@if(TempData["DecisionError"] is string decisionError){<div class="alert alert-danger">@decisionError</div>}
    <div class="summary"><div class="summary-box"><span>تاريخ الطلب</span><strong>@(Model.CreationDate?.ToString("dd/MM/yyyy hh:mm tt")??"—")</strong></div><div class="summary-box"><span>حالة الطلب</span><strong class="state">@RequestState()</strong></div><div class="summary-box"><span>النتيجة النهائية</span><strong>@Text(Model.FinalResult)</strong></div><div class="summary-box"><span>إجمالي الرسوم</span><strong>@(Model.Fees.Sum(x=>x.TotalAmount)?.ToString("N2")??Model.Amount?.ToString("N2")??"—")</strong></div></div>
    @if(!Model.IsSupervisorReadOnly){<section class="decision-card"><h3>موقف مراجعة الطلب</h3><span class="current-decision">الحالة الحالية: @RequestState()</span><form asp-action="SaveDecision" asp-route-id="@Model.Id" method="post" id="decisionForm">@Html.AntiForgeryToken()<label for="decisionNotes">ملاحظات الرفض أو البيانات المطلوب استكمالها</label><textarea id="decisionNotes" name="notes" class="form-control" placeholder="تُكتب الملاحظات عند الرفض أو طلب استكمال بيانات">@(Model.IsAccepted==true?string.Empty:Model.RejectNotes)</textarea><div class="decision-actions"><button type="button" id="approveWithCommittee" class="btn btn-success">@(Model.IsAccepted==true?"حفظ لجنة جديدة":"موافق وحفظ اللجنة")</button><button type="submit" name="decision" value="reject" class="btn btn-danger decision-needs-notes">مرفوض</button><button type="submit" name="decision" value="complete" class="btn btn-completion decision-needs-notes">استكمال بيانات</button></div></form></section>}
    <section class="section-card"><h3 class="section-title">بيانات الجهة المصدرة والمندوب</h3><div class="info-grid"><div class="info"><span>نوع الجهة المصدرة</span><strong>@Text(Model.ImporterType)</strong></div><div class="info"><span>الشركة / الجهة المصدرة</span><strong>@Text(Model.ImporterName)</strong></div><div class="info"><span>صاحب الشركة / الشخص المسئول</span><strong>@Text(Model.OwnerName)</strong></div><div class="info"><span>عنوان الجهة</span><strong>@Text(Model.OwnerAddress)</strong></div><div class="info"><span>مندوب صاحب الرسالة</span><strong>@Text(Model.DelegateName)</strong></div><div class="info"><span>الرقم القومي للمندوب</span><strong>@Text(Model.DelegateNationalId)</strong></div>@if(Model.DelegateAttachmentId.HasValue){<div class="info full"><span>صورة المندوب المرفقة</span><button type="button" class="btn btn-primary load-delegate-image" data-url="@Url.Action("DelegateAttachment",new{id=Model.DelegateAttachmentId})">عرض صورة المندوب</button><div class="delegate-image-host" style="margin-top:10px"></div></div>}</div></section>
    <section class="section-card"><h3 class="section-title">مسار الرسالة</h3><div class="info-grid"><div class="info"><span>ميناء الشحن</span><strong>@Text(Model.ShippingPort)</strong></div><div class="info"><span>الدولة المستوردة</span><strong>@Text(Model.Country)</strong></div><div class="info"><span>نوع ميناء الوصول</span><strong>@Text(Model.ArrivalPortType)</strong></div><div class="info"><span>ميناء الوصول</span><strong>@Text(Model.ArrivalPort)</strong></div><div class="info"><span>دولة العبور</span><strong>@Text(Model.TransitCountry)</strong></div><div class="info"><span>نوع ميناء العبور</span><strong>@Text(Model.TransitPortType)</strong></div><div class="info"><span>ميناء العبور</span><strong>@Text(Model.TransitPort)</strong></div><div class="info"><span>اسم الباخرة</span><strong>@Text(Model.ShipName)</strong></div><div class="info"><span>وسيلة الشحن / النقل</span><strong>@Text(string.Join(" - ",new[]{Model.ShipmentMean,Model.TransportMean}.Where(x=>!string.IsNullOrWhiteSpace(x))))</strong></div><div class="info"><span>اسم الشركة المستوردة</span><strong>@Text(Model.ImportCompany)</strong></div><div class="info"><span>اسم المرسل إليه</span><strong>@Text(Model.ReceiverName)</strong></div><div class="info"><span>عنوان المرسل إليه</span><strong>@Text(Model.ImportCompanyAddress)</strong></div></div></section>
    <section class="section-card"><h3 class="section-title">مكان الفحص</h3><div class="info-grid"><div class="info"><span>منفذ / محطة الفحص</span><strong>@Text(Model.ExaminationPlace)</strong></div><div class="info"><span>المحافظة</span><strong>@Text(Model.ExaminationGovernorate)</strong></div><div class="info"><span>المركز</span><strong>@Text(Model.ExaminationCenter)</strong></div><div class="info full"><span>عنوان مكان الفحص</span><strong>@Text(Model.ExaminationAddress)</strong></div></div></section>
    <section class="section-card"><h3 class="section-title">مكان الجشني</h3><div class="info-grid"><div class="info"><span>منفذ / محطة الجشني</span><strong>@Text(Model.GenshiPlace)</strong></div><div class="info"><span>نوع المكان</span><strong>@(Model.GenshiStationId.HasValue?"محطة":Model.GenshiOutletId.HasValue?"منفذ":"—")</strong></div><div class="info"><span>تاريخ النتيجة</span><strong>@(Model.FinalResultDate?.ToString("dd/MM/yyyy")??"—")</strong></div></div></section>
    <section class="section-card committee-section">
        <h3 class="section-title">تشكيل لجان الصادر</h3>
        <div class="committee-page-header">
            <div><h3>تسجيل بيانات لجنة الصادر</h3><p>أدخل بيانات اللجنة ثم اختر أعضاء اللجنة وبيانات الرسالة.</p></div>
            <div class="committee-outlet"><span>مكان الفحص</span><strong>@Text(Model.ExaminationPlace)</strong></div>
        </div>
        @if(Model.StationEngineers.Count==0&&Model.GenshiEngineers.Count==0&&Model.OutletEngineers.Count==0)
        {
            <div class="empty-section">لا توجد حسابات موظفين فعالة يمكن تشكيل اللجنة منها.</div>
        }
        else
        {
            <form asp-action="CreateCommittee" asp-route-id="@Model.Id" method="post" class="committee-form import-committee-form" id="committeeForm">
                @Html.AntiForgeryToken()
                <ul class="committee-steps" aria-label="خطوات تشكيل اللجنة">
                    <li class="active" data-step="info">معلومات اللجنة</li>
                    <li data-step="employees">اسم الموظف</li>
                    <li data-step="message">اللوطات وبدلات المهندسين</li>
                </ul>
                <div class="committee-info-card committee-step-pane" data-pane="info">
                    <h4 class="committee-info-title">معلومات اللجنة</h4>
                    <div class="committee-fields">
                        <div class="committee-field"><label for="committeeTypeId">نوع اللجنة</label><select id="committeeTypeId" name="committeeTypeId" class="form-control" required><option value="">--- اختر ---</option><option value="1">لجنة فحص</option><option value="2">لجنة الجشني</option><option value="3">لجنة سحب</option><option value="6">لجنة معالجة</option></select></div>
                        <div class="committee-field"><label>رقم طلب الفحص</label><input type="text" class="form-control" value="@Model.RequestNumber" readonly /></div>
                        <div class="committee-field"><label>تاريخ تسجيل الطلب</label><input type="text" class="form-control" value="@(Model.CreationDate?.ToString("yyyy-MM-dd")??"—")" readonly /></div>
                        <div class="committee-field"><label for="delegationDate">تاريخ اللجنة</label><input id="delegationDate" name="delegationDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required /></div>
                    </div>
                    <div class="committee-actions"><button type="button" class="btn btn-primary committee-next" data-next="employees">التالي</button></div>
                </div>
                <div class="employee-card committee-step-pane" data-pane="employees" hidden>
                    <h4 class="committee-info-title">اختيار أعضاء اللجنة</h4>
                    <p class="employee-help" id="engineersTitle"></p>
                    <div class="fallback-outlet-field" hidden><label for="selectedOutletId">المنفذ البديل</label><select id="selectedOutletId" name="selectedOutletId" class="form-control"><option value="">--- اختر المنفذ ---</option>@foreach(var outlet in Model.CommitteeOutlets){<option value="@outlet.Id">@outlet.Name</option>}</select><small>لا يوجد موظفون مسكنون على المحطة؛ اختر منفذًا لعرض موظفيه.</small></div>
                    <div class="employee-search-grid">
                        <div><label for="employeeNameSearch">اسم الموظف</label><input id="employeeNameSearch" type="search" class="form-control" placeholder="اكتب اسم الموظف" autocomplete="off" /></div>
                        <div><label for="employeeNumberSearch">رقم الموظف</label><input id="employeeNumberSearch" type="search" inputmode="numeric" class="form-control" placeholder="رقم الموظف" autocomplete="off" /></div>
                        <div><button type="button" id="employeeSearchButton" class="btn employee-search-button">بحث</button></div>
                    </div>
                    <div id="employeeSearchMessage" class="employee-empty-message"></div>
                    <h5 class="employee-table-title">نتائج البحث</h5>
                    <div class="table-responsive">
                        <table id="employeeResultsTable" class="table table-bordered table-striped">
                            <thead><tr><th>رقم الموظف</th><th>اسم الموظف</th><th>المنفذ</th><th>تسجيل</th></tr></thead>
                            <tbody>
                            @foreach(var engineer in Model.StationEngineers){<tr class="employee-result" data-stage="inspection" data-from="@(engineer.AssignmentFrom?.ToString("yyyy-MM-dd"))" data-to="@(engineer.AssignmentTo?.ToString("yyyy-MM-dd"))" data-user="@engineer.UserId" data-number="@engineer.EmployeeId" data-name="@engineer.Name"><td>@engineer.EmployeeId</td><td>@engineer.Name</td><td>@Text(Model.ExaminationStationName)</td><td><input class="employee-select-check" type="checkbox" name="employeeIds" value="@engineer.UserId" disabled /></td></tr>}
                            @foreach(var engineer in Model.GenshiEngineers){<tr class="employee-result" data-stage="genshi" data-from="@(engineer.AssignmentFrom?.ToString("yyyy-MM-dd"))" data-to="@(engineer.AssignmentTo?.ToString("yyyy-MM-dd"))" data-user="@engineer.UserId" data-number="@engineer.EmployeeId" data-name="@engineer.Name"><td>@engineer.EmployeeId</td><td>@engineer.Name</td><td>@Text(Model.GenshiStationName)</td><td><input class="employee-select-check" type="checkbox" name="employeeIds" value="@engineer.UserId" disabled /></td></tr>}
                            @foreach(var engineer in Model.OutletEngineers){<tr class="employee-result" data-stage="outlet" data-outlet="@engineer.OutletId" data-user="@engineer.UserId" data-number="@engineer.EmployeeId" data-name="@engineer.Name"><td>@engineer.EmployeeId</td><td>@engineer.Name</td><td>@engineer.OutletName</td><td><input class="employee-select-check" type="checkbox" name="employeeIds" value="@engineer.UserId" disabled /></td></tr>}
