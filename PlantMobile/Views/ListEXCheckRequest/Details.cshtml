                        </table>
                    </div>
                    <div class="employee-pagination" id="employeePagination"><button type="button" class="btn page-prev">السابق</button><span class="page-info"></span><button type="button" class="btn page-next">التالي</button></div>
                    <h5 class="employee-table-title">أعضاء اللجنة المختارون</h5>
                    <div class="table-responsive">
                        <table id="selectedEmployeesTable" class="table table-bordered table-striped"><thead><tr><th>اسم المهندس</th><th>كود المهندس</th><th>أدمن</th><th>حذف</th></tr></thead><tbody></tbody></table>
                    </div>
