                            <div class="shift-entry-grid"><div><label for="shiftTimingSelect">النوبتجية</label><select id="shiftTimingSelect" class="form-control"><option value="">اختر النوبتجية</option>@foreach(var shift in Model.ShiftTimings){<option value="@shift.Id" data-amount="@shift.Amount">@shift.Name</option>}</select></div><div><label for="shiftMoney">القيمة</label><input id="shiftMoney" class="form-control" readonly /></div><div><label for="shiftCount">عدد الأيام</label><input id="shiftCount" type="number" min="1" value="1" class="form-control" /></div><div><button id="addShift" type="button" class="btn btn-primary">إضافة</button></div></div>
                            <div class="table-responsive"><table id="shiftTable" class="table table-bordered table-striped sample-table"><thead><tr><th>النوبتجية</th><th>القيمة</th><th>عدد الأيام</th><th>حذف</th></tr></thead><tbody><tr class="shift-empty"><td colspan="4">لم تتم إضافة بيانات نوبتجية.</td></tr></tbody></table></div>
                        </div>
                    </div>
                    <div class="committee-actions between"><button type="button" class="btn btn-default committee-prev" data-prev="employees">السابق</button><span class="text-success"><strong>@(Model.IsAccepted==true?"اضغط «حفظ لجنة جديدة» لإضافة اللجنة على الطلب الموافق عليه.":"سيتم حفظ اللجنة عند الضغط على «موافق وحفظ اللجنة».")</strong></span></div>
                </div>
            </form>
        }
        @if(Model.Committees.Count>0)
        {
            <div class="committee-list"><h4>اللجان المشكلة على الطلب</h4><div class="table-responsive"><table class="table table-striped"><thead><tr><th>رقم اللجنة</th><th>النوع</th><th>التاريخ</th><th>المهندسون</th><th>السجلات الكلية</th></tr></thead><tbody>@foreach(var committee in Model.Committees){<tr><td>@committee.Id</td><td>@committee.CommitteeType</td><td>@(committee.DelegationDate?.ToString("dd/MM/yyyy")??"—")</td><td>@Text(committee.Employees)</td><td>@committee.LotCount</td></tr>}</tbody></table></div></div>
        }
    </section>
    <section class="section-card"><h3 class="section-title">بيانات الرسالة</h3>@if(Model.Items.Count==0){<div class="empty-section">لا توجد أصناف مسجلة على الطلب</div>}@foreach(var item in Model.Items){<article class="item-card"><div class="item-head"><h4>@Text(item.ShortName)</h4><strong class="@(item.IsAccepted?"accept":"reject")">@(item.IsAccepted?"مقبول":"غير مقبول")</strong></div><div class="item-stats"><span>اسم المنتج: <strong>@Text(item.Category)</strong></span><span>المجموعة: <strong>@Text(item.CategoryGroup)</strong></span><span>كود المزرعة: <strong>@Text(item.FarmCode)</strong></span><span>اسم المزرعة: <strong>@Text(item.FarmName)</strong></span></div>@if(item.Lots.Count>0){<div class="lots"><div class="table-responsive"><table class="table table-striped"><thead><tr><th>رقم اللوط</th><th>العدد ونوع العبوة</th><th>مادة العبوة</th><th>وزن العبوة القائم</th><th>وزن العبوة الصافي</th><th>الوزن الإجمالي</th><th>الوزن الصافي</th><th>رقم المزرعة</th><th>النتيجة</th></tr></thead><tbody>@foreach(var lot in item.Lots){<tr><td>@Text(lot.LotNumber)</td><td>@(lot.PackageCount?.ToString()??"—") @Text(lot.PackageType)</td><td>@Text(lot.PackageMaterial)</td><td>@(lot.PackageGrossWeight?.ToString("N3")??"—")</td><td>@(lot.PackageNetWeight?.ToString("N3")??"—")</td><td>@(lot.GrossWeight?.ToString("N3")??"—")</td><td>@(lot.NetWeight?.ToString("N3")??"—")</td><td>@Text(lot.GrowerNumber)</td><td class="@(lot.IsAccepted==false?"reject":"accept")">@(lot.IsAccepted==true?"مقبول":lot.IsAccepted==false?"مرفوض":"لم تحدد")</td></tr>}</tbody></table></div></div>}</article>}</section>
    <section class="section-card"><h3 class="section-title">المرفقات</h3>@if(Model.Attachments.Count==0){<div class="empty-section">لا توجد مرفقات على الطلب</div>}else{<div class="table-responsive lots"><table class="table table-striped"><thead><tr><th>م</th><th>نوع المرفق</th><th>رقم المرفق</th><th>تاريخ البداية</th><th>تاريخ النهاية</th><th>الملف</th></tr></thead><tbody>@for(int i=0;i<Model.Attachments.Count;i++){var attachment=Model.Attachments[i];<tr><td>@(i+1)</td><td>@Text(attachment.Name)</td><td>@Text(attachment.Number)</td><td>@(attachment.StartDate?.ToString("dd/MM/yyyy")??"—")</td><td>@(attachment.EndDate?.ToString("dd/MM/yyyy")??"—")</td><td>@if(!string.IsNullOrWhiteSpace(attachment.Path)){<a href="@attachment.Path" target="_blank" rel="noopener">عرض المرفق</a>}else{<span>—</span>}</td></tr>}</tbody></table></div>}</section>
    <section class="section-card"><h3 class="section-title">الرسوم وحالة السداد</h3><div class="info-grid"><div class="info full"><span>حالة سداد الطلب</span><strong class="@(Model.IsPaid==true?"accept":"reject")">@(Model.IsPaid==true?"تم الدفع":"لم يتم الدفع")</strong></div></div>@if(Model.Fees.Count==0){<div class="empty-section">لا توجد رسوم مسجلة</div>}else{<div class="table-responsive lots"><table class="table table-striped"><thead><tr><th>نوع الرسم</th><th>المصدر</th><th>رقم أمر الدفع</th><th>الوزن القائم</th><th>قيمة الرسم</th><th>الإجمالي</th><th>حالة الدفع</th><th>تقريب</th></tr></thead><tbody>@foreach(var fee in Model.Fees){<tr><td>@Text(fee.FeeType)</td><td>@Text(fee.Source)</td><td>@Text(fee.OrderNumber)</td><td>@(fee.TotalGrossWeight?.ToString("N3")??"—")</td><td>@(fee.FeeValue?.ToString("N2")??"—")</td><td>@(fee.TotalAmount?.ToString("N2")??"—")</td><td class="@(fee.IsPaid==true?"accept":"reject")">@(fee.IsPaid==true?"تم الدفع":"لم يتم الدفع")</td><td>@(fee.IsRounded==true?"نعم":fee.IsRounded==false?"لا":"—")</td></tr>}</tbody></table></div>}</section>
    @if(!string.IsNullOrWhiteSpace(Model.RejectNotes)){<section class="section-card"><h3 class="section-title">ملاحظات الرفض</h3><div class="info-grid"><div class="info full"><strong class="reject">@Model.RejectNotes</strong></div></div></section>}
    </div>
</div>
@functions{string Text(string? value)=>string.IsNullOrWhiteSpace(value)?"—":value;string RequestState()=>Model.ClosedRequest==1?"مغلق":!string.IsNullOrWhiteSpace(Model.FinalResult)?"ظهرت النتيجة":Model.IsAccepted==true?"موافق":Model.IsAccepted==false?"مرفوض":!string.IsNullOrWhiteSpace(Model.RejectNotes)?"مطلوب استكمال بيانات":"قيد المراجعة";}
<script>
document.addEventListener('DOMContentLoaded',function(){
    var detailsBody=document.querySelector('.details-body');
    var committeeSection=detailsBody&&detailsBody.querySelector(':scope>.committee-section');
    var decisionSection=detailsBody&&detailsBody.querySelector(':scope>.decision-card');
    if(detailsBody&&committeeSection)detailsBody.appendChild(committeeSection);
    if(detailsBody&&decisionSection)detailsBody.appendChild(decisionSection);
    document.querySelectorAll('.load-delegate-image').forEach(function(button){button.addEventListener('click',function(){
        var host=button.parentElement.querySelector('.delegate-image-host');
        if(host.querySelector('img'))return;
        var image=document.createElement('img');image.alt='صورة المندوب';image.style.cssText='max-width:260px;max-height:190px;border:1px solid #dce6e9;border-radius:8px;padding:4px';
        image.onerror=function(){host.innerHTML='<span class="reject">تعذر تحميل الصورة من سيرفر المرفقات.</span>';button.disabled=false;};
        button.disabled=true;button.textContent='جارٍ تحميل الصورة...';image.onload=function(){button.remove();};image.src=button.dataset.url;host.appendChild(image);
    });});
    document.querySelectorAll('.details-body>.section-card').forEach(function(card,index){
        var title=card.querySelector(':scope>.section-title');if(!title)return;
        card.classList.add('accordion-card');title.setAttribute('role','button');title.setAttribute('tabindex','0');
        var content=document.createElement('div');content.className='accordion-content';content.id='detailsAccordion'+index;
        while(title.nextSibling)content.appendChild(title.nextSibling);card.appendChild(content);
        var arrow=document.createElement('span');arrow.className='accordion-arrow';arrow.setAttribute('aria-hidden','true');arrow.innerHTML='<i class="fas fa-chevron-down"></i>';title.appendChild(arrow);
        var open=index===0;card.classList.toggle('is-open',open);content.hidden=!open;title.setAttribute('aria-expanded',open?'true':'false');title.setAttribute('aria-controls',content.id);
        function toggle(){var next=content.hidden;content.hidden=!next;card.classList.toggle('is-open',next);title.setAttribute('aria-expanded',next?'true':'false');}
        title.addEventListener('click',toggle);title.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();toggle();}});
    });
    document.querySelectorAll('.committee-list tbody tr').forEach(function(row){var cell=row.cells[0],id=(cell&&cell.textContent||'').trim();if(/^\d+$/.test(id)){var link=document.createElement('a');link.href='/ExportRequests/Committees/'+id;link.className='btn btn-sm btn-primary d-block mt-1';link.textContent='فتح عمل اللجنة';cell.appendChild(link);}});
});
</script>
@section Scripts{
<script>
$(function(){
    $('#decisionForm .decision-needs-notes').on('click',function(e){if(!$.trim($('#decisionNotes').val())){e.preventDefault();alert('اكتب سبب الرفض أو البيانات المطلوب استكمالها.');$('#decisionNotes').focus();}});
    var $form=$('#committeeForm');
    if(!$form.length)return;
    var employeePage=1,employeePageSize=5,approvalRequested=false;

    function requestedStage(){return $('#committeeTypeId').val()==='2'?'genshi':'inspection';}
    function rowDateEligible($row){
        var date=$('#delegationDate').val(),from=String($row.data('from')||''),to=String($row.data('to')||'');
        return !date||((!from||from<=date)&&(!to||to>=date));
    }
    function activeStage(){
        var stage=requestedStage();
        var found=false;$('#employeeResultsTable .employee-result[data-stage="'+stage+'"]').each(function(){if(rowDateEligible($(this)))found=true;});
        return found?stage:'outlet';
    }
    function refreshRows(){
        var stage=activeStage(),outlet=String($('#selectedOutletId').val()||'');
        var name=$.trim($('#employeeNameSearch').val()).toLowerCase(),matched=[];
        var number=$.trim($('#employeeNumberSearch').val());
        var visible=0;
        $('#employeeResultsTable .employee-result').each(function(){
            var $row=$(this),sameStage=$row.data('stage')===stage;
            var sameOutlet=stage!=='outlet'||(outlet&&String($row.data('outlet'))===outlet);
            var eligible=sameStage&&sameOutlet&&(stage==='outlet'||rowDateEligible($row));
            var sameName=!name||String($row.data('name')||'').toLowerCase().indexOf(name)>=0;
            var sameNumber=!number||String($row.data('number')||'').indexOf(number)>=0;
            var show=eligible&&sameName&&sameNumber;
            $row.hide();$row.find('.employee-select-check').prop('disabled',!eligible);
            if(show){matched.push(this);visible++;}
        });
        var totalPages=Math.max(1,Math.ceil(matched.length/employeePageSize));employeePage=Math.min(Math.max(1,employeePage),totalPages);
        $(matched.slice((employeePage-1)*employeePageSize,employeePage*employeePageSize)).show();
        $('#employeePagination').toggle(matched.length>0);$('#employeePagination .page-info').text('صفحة '+employeePage+' من '+totalPages+' — عدد النتائج '+matched.length);
        $('#employeePagination .page-prev').prop('disabled',employeePage<=1);$('#employeePagination .page-next').prop('disabled',employeePage>=totalPages);
        $('#employeeSearchMessage').toggle(visible===0).text(stage==='outlet'&&!outlet?'اختر المنفذ أولًا لعرض موظفيه.':visible===0?'لا يوجد موظفون مطابقون لبيانات البحث.':'');
    }
    function resetSelection(){
        $('.employee-select-check').prop('checked',false);
        $('#selectedEmployeesTable tbody').empty();
        $('#adminEmployeeId').val('');
    }
    function updateStage(){
        var stage=activeStage(),fallback=stage==='outlet',genshi=requestedStage()==='genshi';
        resetSelection();
        $('.fallback-outlet-field').prop('hidden',!fallback);
        $('#selectedOutletId').prop('required',fallback);
        if(!fallback)$('#selectedOutletId').val('');
        $('#engineersTitle').text((genshi?'موظفو مكان الجشني: @Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Text(Model.GenshiStationName)))':'موظفو مكان الفحص: @Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Text(Model.ExaminationStationName)))')+(fallback?' — لا يوجد تسكين حالي، اختر منفذًا بديلًا':''));
        employeePage=1;$('#employeeNameSearch,#employeeNumberSearch').val('');
        refreshRows();
    }
    function toggleCommitteeOptions(){
        var sample=$('#committeeTypeId').val()==='3';
        $('#sampleLabsCard').toggle(sample).attr('aria-hidden',sample?'false':'true');
        if(!sample)$('.sample-lab-check').prop('checked',false);
    }
    function addSelected($source){
        var id=String($source.data('user')),name=String($source.data('name')||''),number=String($source.data('number')||'');
        if($('#selectedEmployeesTable tbody tr[data-user="'+id+'"]').length)return;
        $('#selectedEmployeesTable tbody').append('<tr data-user="'+id+'"><td></td><td></td><td><input type="radio" class="admin-radio" name="adminChoice" value="'+id+'" aria-label="تحديد كرئيس اللجنة" /></td><td><button type="button" class="remove-employee">حذف</button></td></tr>');
        var $row=$('#selectedEmployeesTable tbody tr[data-user="'+id+'"]');
        $row.children().eq(0).text(name);$row.children().eq(1).text(number||'—');
        if(!$('#adminEmployeeId').val()){$row.find('.admin-radio').prop('checked',true);$('#adminEmployeeId').val(id);}
    }

    $('#committeeTypeId').on('change',function(){updateStage();toggleCommitteeOptions();});
    $('#delegationDate').on('change',updateStage);
    $('#selectedOutletId').on('change',function(){employeePage=1;resetSelection();refreshRows();});
    $('#employeeSearchButton').on('click',function(){employeePage=1;refreshRows();});
    $('#employeeNameSearch,#employeeNumberSearch').on('input',function(){employeePage=1;refreshRows();});
    $('#employeePagination .page-prev').on('click',function(){if(employeePage>1){employeePage--;refreshRows();}});
    $('#employeePagination .page-next').on('click',function(){employeePage++;refreshRows();});
    $('#labSearch').on('input',function(){var value=$.trim(this.value).toLowerCase();$('#analysisLabsTable tbody tr').each(function(){$(this).toggle(!value||$(this).text().toLowerCase().indexOf(value)>=0);});});
    $('#shiftTimingSelect').on('change',function(){$('#shiftMoney').val($(this).find(':selected').data('amount')||'');});
    $('#addShift').on('click',function(){
        var $option=$('#shiftTimingSelect option:selected'),id=$option.val(),name=$option.text(),amount=Number($option.data('amount')||0),count=parseInt($('#shiftCount').val(),10);
        if(!id||!count||count<1){alert('اختر النوبتجية وأدخل عدد أيام صحيح.');return;}
        if($('#shiftTable tbody tr[data-shift="'+id+'"]').length){alert('تمت إضافة هذه النوبتجية من قبل.');return;}
        $('#shiftTable .shift-empty').remove();
        $('#shiftTable tbody').append('<tr data-shift="'+id+'"><td>'+name+'<input type="hidden" name="shiftTimingIds" value="'+id+'" /></td><td>'+(amount*count).toFixed(2)+'</td><td>'+count+'<input type="hidden" name="shiftCounts" value="'+count+'" /></td><td><button type="button" class="remove-shift">حذف</button></td></tr>');
        $('#shiftTimingSelect').val('');$('#shiftMoney').val('');$('#shiftCount').val('1');
    });
    $(document).on('click','.remove-shift',function(){$(this).closest('tr').remove();if(!$('#shiftTable tbody tr').length)$('#shiftTable tbody').html('<tr class="shift-empty"><td colspan="4">لم تتم إضافة بيانات نوبتجية.</td></tr>');});
    $(document).on('change','.employee-select-check',function(){
        var $row=$(this).closest('.employee-result');
        if(this.checked)addSelected($row);
        else {
            $('#selectedEmployeesTable tbody tr[data-user="'+$row.data('user')+'"]').remove();
            if(String($('#adminEmployeeId').val())===String($row.data('user'))){$('#adminEmployeeId').val('');var $first=$('#selectedEmployeesTable .admin-radio').first();if($first.length){$first.prop('checked',true);$('#adminEmployeeId').val($first.val());}}
        }
    });
    $(document).on('change','.admin-radio',function(){$('#adminEmployeeId').val(this.value);});
    $(document).on('click','.remove-employee',function(){
        var $row=$(this).closest('tr'),id=String($row.data('user'));
        $('#employeeResultsTable .employee-result[data-user="'+id+'"] .employee-select-check').prop('checked',false);
        $row.remove();
        if(String($('#adminEmployeeId').val())===id){$('#adminEmployeeId').val('');var $first=$('#selectedEmployeesTable .admin-radio').first();if($first.length){$first.prop('checked',true);$('#adminEmployeeId').val($first.val());}}
    });
    function showStep(step){
        if(step==='message')toggleCommitteeOptions();
        $('.committee-step-pane').prop('hidden',true).filter('[data-pane="'+step+'"]').prop('hidden',false);
        var order=['info','employees','message'],position=order.indexOf(step);
        $('.committee-steps li').each(function(){var index=order.indexOf(String($(this).data('step')));$(this).toggleClass('active',index===position).toggleClass('done',index<position);});
    }
    function validateInfo(){
        if(!$('#committeeTypeId').val()){alert('يجب اختيار نوع اللجنة.');return false;}
        if(!$('#delegationDate').val()){alert('يجب اختيار تاريخ اللجنة.');return false;}
        return true;
    }
    function validateEmployees(){
        if(activeStage()==='outlet'&&!$('#selectedOutletId').val()){alert('اختر المنفذ البديل.');return false;}
        if(!$('.employee-select-check:checked:not(:disabled)').length){alert('يجب اختيار موظف واحد على الأقل.');return false;}
        if(!$('#adminEmployeeId').val()){alert('حدد رئيس اللجنة.');return false;}
        return true;
    }
    $('.committee-next').on('click',function(){var next=String($(this).data('next'));if(next==='employees'&&!validateInfo())return;if(next==='message'&&!validateEmployees())return;showStep(next);});
    $('.committee-prev').on('click',function(){showStep(String($(this).data('prev')));});
    $('#approveWithCommittee').on('click',function(){
        if(!validateInfo()){showStep('info');$('#committeeTypeId').focus();return;}
        if(!validateEmployees()){showStep('employees');return;}
        if(!$('.sample-lot-check:checked').length){showStep('message');alert('اختر لوطًا واحدًا على الأقل لعمل اللجنة.');return;}
        if($('#committeeTypeId').val()==='3'&&!$('.sample-lab-check:checked').length){showStep('message');alert('اختر تحليلًا ومعملًا واحدًا على الأقل.');return;}
        approvalRequested=true;$form.trigger('submit');
    });
    $form.on('submit',function(e){
        if(!approvalRequested){e.preventDefault();return;}
        if(!$('#committeeTypeId').val()){e.preventDefault();alert('يجب اختيار نوع اللجنة.');return;}
        if(activeStage()==='outlet'&&!$('#selectedOutletId').val()){e.preventDefault();alert('اختر المنفذ البديل.');return;}
        if(!$('.employee-select-check:checked:not(:disabled)').length){e.preventDefault();alert('يجب اختيار موظف واحد على الأقل.');return;}
        if(!$('#adminEmployeeId').val()){e.preventDefault();alert('حدد رئيس اللجنة.');return;}
        if(!$('.sample-lot-check:checked').length){e.preventDefault();showStep('message');alert('اختر لوطًا واحدًا على الأقل لعمل اللجنة.');return;}
        if($('#committeeTypeId').val()==='3'&&!$('.sample-lab-check:checked').length){e.preventDefault();showStep('message');alert('اختر تحليلًا ومعملًا واحدًا على الأقل.');return;}
    });
    updateStage();toggleCommitteeOptions();
});
</script>
}
