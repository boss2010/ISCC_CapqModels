@model ViewModels.ExportStationDashboardVm
@{ViewData["Title"]="متابعة محطات الصادر";int first=Model.TotalCount==0?0:((Model.Page-1)*Model.PageSize)+1;int last=Math.Min(Model.Page*Model.PageSize,Model.TotalCount);}
<style>
    .stations-page{direction:rtl;max-width:1500px;margin:auto;padding:28px 18px;color:#263b42}.stations-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.stations-head h2{margin:0;color:#246f73;font-weight:800}.stations-head p{margin:6px 0;color:#71838a}.search-card,.stations-card{background:#fff;border:1px solid #e2eaed;border-radius:15px;box-shadow:0 6px 22px rgba(27,61,68,.07)}.search-card{padding:18px;margin-bottom:20px}.search-form{display:flex;gap:10px;max-width:720px;margin:auto}.search-form .form-control{height:42px;border-radius:8px}.search-form .btn{min-width:100px;border-radius:8px}.stations-card{overflow:hidden}.card-head{padding:15px 20px;border-bottom:1px solid #e6edef;display:flex;justify-content:space-between;align-items:center}.count{background:#edf7f7;color:#246f73;padding:7px 13px;border-radius:20px;font-weight:700}.stations-table{margin:0}.stations-table thead{background:#287f82;color:#fff}.stations-table th,.stations-table td{text-align:center;vertical-align:middle;border:0;padding:12px 9px}.stations-table tbody td{border-bottom:1px solid #edf1f2}.stations-table tbody tr:nth-child(even){background:#f8fafb}.station-name{text-align:right!important;min-width:240px}.station-name strong{display:block;color:#263b42}.station-name small{color:#778990}.number{display:inline-block;min-width:35px;padding:5px 8px;border-radius:15px;background:#edf2f4;font-weight:700}.request-link{display:inline-block;min-width:45px;padding:7px 12px;border-radius:8px;background:#e5f4f4;color:#176c70;font-weight:800;text-decoration:none}.request-link:hover{background:#176c70;color:#fff}.engineers-ok{color:#177245;background:#e5f6ed}.engineers-none{color:#a4323c;background:#fde9eb}.engineer-state{display:inline-block;border-radius:18px;padding:6px 11px;font-size:12px;font-weight:700}.pager{display:flex;justify-content:center;padding:18px}.pagination{margin:0}.page-item.active .page-link{background:#287f82;border-color:#287f82}.page-link{color:#287f82}.empty{padding:40px!important;color:#75868c}
    @@media(max-width:650px){.stations-page{padding:16px 10px}.stations-head{align-items:flex-start;flex-direction:column;gap:10px}.search-form{flex-direction:column}.search-form .btn{width:100%}.card-head{align-items:flex-start;flex-direction:column;gap:8px}}
</style>
<div class="stations-page">
    <div class="stations-head"><div><h2>متابعة محطات الصادر</h2><p>الطلبات واللجان والمهندسون المسكنون حاليًا على كل محطة</p></div><a asp-action="Index" class="btn btn-outline-secondary">كل طلبات الفحص</a></div>
    <div class="search-card"><form method="get" asp-action="Stations" class="search-form"><input class="form-control" name="search" value="@Model.Search" placeholder="ابحث باسم المحطة أو الكود"/><button class="btn btn-primary" type="submit">بحث</button><a asp-action="Stations" class="btn btn-outline-secondary">مسح</a></form></div>
    <div class="stations-card"><div class="card-head"><strong>قائمة المحطات</strong><span class="count">عرض @first–@last من @Model.TotalCount</span></div><div class="table-responsive"><table class="table stations-table"><thead><tr><th>م</th><th>المحطة</th><th>المحافظة</th><th>الطلبات</th><th>إجمالي اللجان</th><th>فحص</th><th>سحب</th><th>معالجة</th><th>المهندسون حاليًا</th></tr></thead><tbody>
    @if(Model.Stations.Count==0){<tr><td colspan="9" class="empty">لا توجد محطات مطابقة للبحث</td></tr>}
    @foreach(var row in Model.Stations){<tr><td>@row.RowNumber</td><td class="station-name"><strong>@row.StationName</strong>@if(!string.IsNullOrWhiteSpace(row.StationCode)){<small>كود: @row.StationCode</small>}</td><td>@(string.IsNullOrWhiteSpace(row.Governorate)?"—":row.Governorate)</td><td><a asp-action="Index" asp-route-stationId="@row.StationId" class="request-link" title="عرض طلبات المحطة">@row.RequestCount</a></td><td><span class="number">@row.CommitteeCount</span></td><td>@row.InspectionCount</td><td>@row.SamplingCount</td><td>@row.TreatmentCount</td><td>@if(row.CurrentEngineerCount>0){<span class="engineer-state engineers-ok">عليها @row.CurrentEngineerCount مهندس</span>}else{<span class="engineer-state engineers-none">بدون مهندسين</span>}</td></tr>}
    </tbody></table></div>@if(Model.TotalPages>1){int start=Math.Max(1,Model.Page-2),end=Math.Min(Model.TotalPages,Model.Page+2);<nav class="pager"><ul class="pagination"><li class="page-item @(Model.Page==1?"disabled":"")"><a class="page-link" href="@PageUrl(Model.Page-1)">السابق</a></li>@for(int p=start;p<=end;p++){<li class="page-item @(p==Model.Page?"active":"")"><a class="page-link" href="@PageUrl(p)">@p</a></li>}<li class="page-item @(Model.Page>=Model.TotalPages?"disabled":"")"><a class="page-link" href="@PageUrl(Model.Page+1)">التالي</a></li></ul></nav>}</div>
</div>
@functions{string PageUrl(int page)=>Url.Action("Stations",new{page,search=Model.Search})??"#";}
