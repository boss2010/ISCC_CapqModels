@{
    var showMenu = Context.Session.GetString("UserSession") == "Authenticated";
    var headerUserName = Context.Session.GetString("UserFullName") ?? Context.Session.GetString("UserName") ?? "";
    var headerOutletName = Context.Session.GetString("OutletName") ?? "غير محدد";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Capq</title>

    <!-- Font Awesome -->
    <link href="~/fontawesome-free-5.15.4-web/css/all.min.css" rel="stylesheet" />
    <!-- Flaticon Font -->
    <link href="~/lib/flaticon/font/flaticon.css" rel="stylesheet" />

    <!-- Libraries Stylesheet -->
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <!-- Customized Bootstrap Stylesheet -->
    @*     <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/bootstrap-select.css" rel="stylesheet" /> *@
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/custom.css" rel="stylesheet"  />
    <link href="~/css/menu-sidebar.css" rel="stylesheet" />
    <script src="~/lib/jquery/jquery.min.js"></script>
    <style>
        .header-account{display:flex;align-items:center;gap:10px;margin-left:12px;padding:5px 7px 5px 5px;border:1px solid rgba(255,255,255,.18);border-radius:11px;background:rgba(255,255,255,.07)}
        .header-user-summary{display:flex;align-items:center;gap:13px;color:#fff;text-align:right;font-size:.84rem;line-height:1.2;white-space:nowrap}
        .header-user-summary span{display:inline-flex;align-items:center;white-space:nowrap}
        .header-user-summary i{color:#e7b04b;font-size:.8rem}
        .header-logout{display:inline-flex;align-items:center;gap:6px;min-height:34px;padding:6px 12px;border:0;border-radius:8px;background:#b94343;color:#fff;font-weight:700;white-space:nowrap;box-shadow:none}
        .header-logout:hover,.header-logout:focus{background:#9f3030;color:#fff;box-shadow:0 0 0 3px rgba(255,255,255,.14)}
        @@media(max-width:991.98px){.site-header-actions{flex-wrap:wrap;justify-content:center;gap:8px}.header-account{order:5;width:100%;justify-content:center;margin:4px 0 0}.site-header-actions .ml-2{margin-left:0!important}}
        @@media(max-width:575.98px){.header-account{gap:7px;padding:5px}.header-user-summary{gap:8px;font-size:.76rem;overflow-x:auto}.header-user-summary i{display:none}.header-logout{padding:6px 9px;font-size:.78rem}}
    </style>

</head>
<body>
    <!-- Topbar Start -->
    <div class="container-fluid bg-dark py-3">
        <div class="container">
            <div class="row">
                <div class="col-md-6 text-center text-lg-right">
                    <div class="align-items-center">
                        <span class="color-white">وزارة الزراعة</span>
                        <br />
                        <span class="color-white">الإدارة المركزيه للحجر الزراعي</span>
                    </div>
                </div>
                <div class="col-md-6 text-center text-lg-left mb-2 mb-lg-0">
                    <div class="site-header-actions d-inline-flex align-items-center">
                        <button type="button" class="btn btn-outline-light pq-menu-toggle ml-2" id="pq-menu-toggle"
                                aria-controls="pq-sidebar" aria-expanded="false" aria-label="القائمة">
                            <i class="fas fa-bars"></i>
                        </button>
                        @if (showMenu)
                        {
                            <div class="header-account" dir="rtl">
                                <div class="header-user-summary">
                                    <span><i class="fas fa-user ml-1"></i>@headerUserName</span>
                                    <span><i class="fas fa-map-marker-alt ml-1"></i>@headerOutletName</span>
                                </div>
                                <form asp-controller="Login" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit" class="header-logout"><i class="fas fa-sign-out-alt"></i><span>تسجيل الخروج</span></button>
                                </form>
                            </div>
                        }
                        <a asp-controller="LaboratoryResult" asp-action="Index" class="btn btn-warning ml-2">نتيجة المعمل</a>
                        <a href="" class="navbar-brand">
                            <img src="~/img/logo-capq2.png" class="logo" />
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <!-- Topbar End -->
   

    @if (showMenu)
    {
        <div class="pq-shell">
            <aside class="pq-sidebar" id="pq-sidebar">
                <vc:menu />
            </aside>
            <div class="pq-main">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
        <div class="pq-backdrop" id="pq-backdrop"></div>
    }
    else
    {
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    }
   

    <!-- JavaScript Libraries -->
    <script src="~/bootstrap.bundle.min.js"></script>

    <script src="~/lib/easing/easing.min.js"></script>
    <script src="~/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/lib/isotope/isotope.pkgd.min.js"></script>
    <script src="~/lib/lightbox/js/lightbox.min.js"></script>
    <!-- Template Javascript -->
    <script src="~/js/main.js"></script>

    <script src="~/js/site.js" ></script>
    <script src="~/js/menu-sidebar.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

